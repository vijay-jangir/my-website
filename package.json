{
  "name": "vijayjangir",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint .",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "astro check",
    "check": "npm run lint && npm run typecheck && npm run test:run && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "vercel:build": "npx vercel build --yes"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,astro,css,json,md}": [
      "prettier --write"
    ],
    "*.{js,jsx,ts,tsx,astro}": [
      "eslint --fix"
    ]
  },
  "engines": {
    "node": "24.x"
  },
  "overrides": {
    "vite": "^7.3.1"
  },
  "dependencies": {
    "@react-pdf/renderer": "^4.3.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "arctic": "^3.7.0",
    "astro": "^6.1.3",
    "clsx": "^1.2.1",
    "framer-motion": "^12.38.0",
    "jose": "^6.2.2",
    "pg": "^8.20.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-icons": "^4.10.1",
    "resend": "^0.16.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/react": "^5.0.2",
    "@astrojs/vercel": "^10.0.4",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.20.0",
    "@types/react": "18.2.14",
    "@types/react-dom": "18.2.6",
    "@typescript-eslint/eslint-plugin": "^8.58.0",
    "@typescript-eslint/parser": "^8.58.0",
    "astro-eslint-parser": "^1.4.0",
    "eslint": "^8.57.1",
    "eslint-plugin-astro": "^1.6.0",
    "eslint-plugin-react": "^7.37.5",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.6.2",
    "prettier-plugin-astro": "^0.14.1",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.3",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.2"
  }
}
