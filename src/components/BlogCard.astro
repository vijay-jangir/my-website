---
import type { BlogPost } from "@/lib/blog";

type Props = {
  post: BlogPost;
};

const { post } = Astro.props;
const href = post.canonicalUrl ?? `/blog/${encodeURIComponent(post.slug)}`;
const isExternal = href.startsWith("http");
const publishedLabel =
  post.publishedAt && !Number.isNaN(post.publishedAt.getTime())
    ? new Intl.DateTimeFormat("en-US", {
        day: "numeric",
        month: "short",
        timeZone: "UTC",
        year: "numeric",
      }).format(post.publishedAt)
    : null;
const readTimeLabel = post.readTime ? `${post.readTime} min read` : null;
const sourceLabel = post.source === "wix" ? "Wix" : "Local";
const metaParts = [publishedLabel, readTimeLabel].filter(Boolean);
---

<a
  class="block rounded-[1.75rem] border border-white/70 bg-white/80 p-6 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl transition hover:-translate-y-1"
  data-blog-card
  data-blog-excerpt={post.description.toLowerCase()}
  data-blog-title={post.title.toLowerCase()}
  href={href}
  rel={isExternal ? "noreferrer" : undefined}
  target={isExternal ? "_blank" : undefined}
>
  <p
    class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
  >
    Technical note
    <span class="ml-2 text-[0.65rem] text-slate-400">{sourceLabel}</span>
  </p>
  {
    metaParts.length > 0 && (
      <p class="mt-3 text-xs font-semibold uppercase tracking-[0.14em] text-slate-400">
        {metaParts.join(" / ")}
      </p>
    )
  }
  <h3
    class="mt-4 font-display text-[1.8rem] font-semibold leading-tight tracking-[-0.045em] text-[#0e1528]"
  >
    {post.title}
  </h3>
  <p class="mt-4 text-base leading-8 text-slate-600">{post.description}</p>
  <p class="mt-6 text-sm font-semibold text-[#1f3b73]">
    {isExternal ? "Read original post" : "Read article"}
  </p>
</a>
