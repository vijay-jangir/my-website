---
type BlogPost = {
  id: string;
  title: string;
  excerpt: string;
  url: {
    base: string;
    path: string;
  };
};

type Props = {
  post: BlogPost;
};

const { post } = Astro.props;
---

<a
  class="block rounded-[1.75rem] border border-white/70 bg-white/80 p-6 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl transition hover:-translate-y-1"
  href={`${post.url.base}${post.url.path}`}
  rel="noreferrer"
  target="_blank"
>
  <p
    class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
  >
    Writing
  </p>
  <h3
    class="mt-4 font-['Sora'] text-[1.8rem] font-semibold leading-tight tracking-[-0.045em] text-[#0e1528]"
  >
    {post.title}
  </h3>
  <p class="mt-4 text-base leading-8 text-slate-600">{post.excerpt}</p>
  <p class="mt-6 text-sm font-semibold text-[#1f3b73]">Read full post</p>
</a>
