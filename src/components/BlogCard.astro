---
type BlogPost = {
  id: string;
  title: string;
  excerpt: string;
  url: {
    base: string;
    path: string;
  };
};

type Props = {
  post: BlogPost;
};

const { post } = Astro.props;
---

<a
  class="glass-panel block rounded-[1.75rem] p-6 hover:-translate-y-0.5"
  href={`${post.url.base}${post.url.path}`}
  rel="noreferrer"
  target="_blank"
>
  <h3 class="text-xl font-semibold tracking-tight">{post.title}</h3>
  <p class="mt-3 text-sm leading-7 text-[var(--muted)]">{post.excerpt}</p>
  <p class="mt-5 text-sm font-semibold text-[var(--accent)]">
    Read on Wix blog
  </p>
</a>
