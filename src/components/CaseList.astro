---
type Props = {
  eyebrow: string;
  title: string;
  items: readonly string[];
};

const { eyebrow, title, items } = Astro.props;
---

<article
  class="rounded-[2.1rem] border border-white/70 bg-white/80 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl"
>
  <div class="flex items-start justify-between gap-4">
    <div>
      <p
        class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
      >
        {eyebrow}
      </p>
      <h2
        class="mt-4 font-display text-3xl font-semibold leading-tight tracking-[-0.045em] text-[#0e1528]"
      >
        {title}
      </h2>
    </div>
    <span
      class="rounded-full border border-slate-200/80 bg-white/90 px-3 py-1.5 text-xs font-semibold text-slate-500"
    >
      {items.length}
    </span>
  </div>
  <ol class="mt-5 space-y-3 text-sm leading-7 text-slate-600">
    {
      items.map((item, index) => (
        <li class="flex gap-3">
          <span class="mt-1 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#1f3b73]/10 text-xs font-semibold text-[#1f3b73]">
            {index + 1}
          </span>
          <span>{item}</span>
        </li>
      ))
    }
  </ol>
</article>
