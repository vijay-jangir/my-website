---
import type { FocusDefinition, FocusId } from "@/lib/portfolio-types";

type Props = {
  activeFocusIds: readonly FocusId[];
  basePath: string;
  focusOptions: readonly FocusDefinition[];
  query?: Record<string, string | undefined>;
};

const { activeFocusIds, basePath, focusOptions, query = {} } = Astro.props;

const activeSet = new Set(activeFocusIds);
---

<div class="flex flex-wrap gap-2">
  {
    focusOptions.map((focus) => {
      const isActive = activeSet.has(focus.id);
      const params = new URLSearchParams();

      Object.entries(query).forEach(([key, value]) => {
        if (value) {
          params.set(key, value);
        }
      });

      if (focus.id !== "general") {
        params.set("focus", focus.id);
      }

      const href =
        params.size > 0 ? `${basePath}?${params.toString()}` : basePath;

      return (
        <a
          class:list={[
            "rounded-full px-4 py-2 text-sm font-semibold",
            isActive
              ? "bg-[var(--accent)] text-white"
              : "border border-[var(--line)] bg-white/70 text-[var(--muted)] hover:border-[var(--accent)] hover:text-[var(--ink)]",
          ]}
          href={href}
        >
          {focus.shortLabel}
        </a>
      );
    })
  }
</div>
