---
import { getSkillLabel } from "@/lib/portfolio";
import type { ProjectDefinition } from "@/lib/portfolio-types";

type Props = {
  project: ProjectDefinition;
};

const { project } = Astro.props;
---

<article class="glass-panel rounded-[2rem] p-6">
  <div
    class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between"
  >
    <div class="max-w-3xl">
      <h3 class="text-2xl font-semibold tracking-tight">{project.title}</h3>
      <p class="mt-3 text-sm leading-7 text-[var(--muted)]">
        {project.summary}
      </p>
    </div>
    <div class="flex flex-wrap gap-2">
      {
        project.skillIds.map((skillId) => (
          <span class="rounded-full border border-[var(--line)] bg-white/80 px-3 py-1 text-xs font-semibold text-[var(--muted)]">
            {getSkillLabel(skillId)}
          </span>
        ))
      }
    </div>
  </div>

  <div class="mt-6 grid gap-5 lg:grid-cols-2">
    <div>
      <p class="eyebrow text-xs text-[var(--muted)]">Impact</p>
      <p class="mt-3 text-sm leading-7 text-[var(--muted)]">{project.impact}</p>
    </div>
    <div>
      <p class="eyebrow text-xs text-[var(--muted)]">Implementation note</p>
      <p class="mt-3 text-sm leading-7 text-[var(--muted)]">{project.detail}</p>
    </div>
  </div>

  {
    project.proofLinks.length > 0 ? (
      <div class="mt-6 flex flex-wrap gap-3">
        {project.proofLinks.map((link) => (
          <a
            class="rounded-full border border-[var(--line)] px-4 py-2 text-sm font-semibold text-[var(--ink)] hover:border-[var(--accent)] hover:bg-[var(--accent-soft)]"
            href={link.href}
            rel="noreferrer"
            target="_blank"
          >
            {link.label}
          </a>
        ))}
      </div>
    ) : null
  }
</article>
