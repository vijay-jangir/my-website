---
import { getSkillLabel } from "@/lib/portfolio";
import type { ProjectDefinition } from "@/lib/portfolio-types";

type Props = {
  project: ProjectDefinition;
  skillLabels?: Record<string, string>;
};

const { project, skillLabels = {} } = Astro.props;
const projectHref = `/projects/${project.slug}`;
const eyebrow = project.caseStudy
  ? project.featured
    ? "Selected system"
    : "Project note"
  : "Project summary";
const ctaLabel = project.caseStudy ? "Open case study" : "Open project note";
---

<article class="border-t border-slate-200/80 py-8">
  <div class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_18rem]">
    <div>
      <p
        class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
      >
        {eyebrow}
      </p>
      <h3
        class="mt-4 max-w-3xl font-display text-[2.15rem] font-semibold leading-tight tracking-[-0.05em] text-[#0e1528] sm:text-[2.7rem]"
      >
        <a class="transition hover:text-[#1f3b73]" href={projectHref}>
          {project.title}
        </a>
      </h3>
      <p class="mt-4 max-w-3xl text-base leading-8 text-slate-600">
        {project.summary}
      </p>
      <a
        class="mt-6 inline-flex items-center rounded-full bg-[#11192c] px-5 py-3 text-sm font-semibold text-white shadow-[0_14px_32px_rgba(17,25,44,0.14)] transition hover:-translate-y-0.5 hover:bg-[#0b1222]"
        href={projectHref}
      >
        {ctaLabel}
      </a>
    </div>
    <div class="flex content-start flex-wrap gap-2 lg:justify-end">
      {
        project.skillIds
          .slice(0, 5)
          .map((skillId) => (
            <span class="rounded-full border border-slate-200/80 bg-white/90 px-3 py-2 text-xs font-semibold text-slate-600">
              {skillLabels[skillId] ?? getSkillLabel(skillId)}
            </span>
          ))
      }
    </div>
  </div>
  <div class="mt-4 flex flex-wrap gap-3">
    {
      project.proofLinks.map((link) => (
        <a
          class="inline-flex items-center rounded-full border border-slate-200/80 bg-white/90 px-5 py-3 text-sm font-semibold text-[#0e1528] shadow-[0_10px_24px_rgba(31,44,75,0.06)] transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-white"
          href={link.href}
          rel="noreferrer"
          target="_blank"
        >
          {link.label}
        </a>
      ))
    }
  </div>
</article>
