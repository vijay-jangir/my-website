---
import { getSkillLabel } from "@/lib/portfolio";
import type { ProjectDefinition } from "@/lib/portfolio-types";

type Props = {
  project: ProjectDefinition;
  skillLabels?: Record<string, string>;
};

const { project, skillLabels = {} } = Astro.props;
---

<article
  class="rounded-[2rem] border border-white/70 bg-white/80 p-6 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:p-8"
>
  <div
    class="flex flex-col gap-5 lg:flex-row lg:items-start lg:justify-between"
  >
    <div class="max-w-3xl">
      <p
        class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
      >
        Selected project
      </p>
      <h3
        class="mt-4 font-['Sora'] text-[2rem] font-semibold leading-tight tracking-[-0.05em] text-[#0e1528] sm:text-[2.4rem]"
      >
        {project.title}
      </h3>
      <p class="mt-4 max-w-2xl text-base leading-8 text-slate-600">
        {project.summary}
      </p>
    </div>
    <div class="flex flex-wrap gap-2 lg:max-w-sm lg:justify-end">
      {
        project.skillIds
          .slice(0, 6)
          .map((skillId) => (
            <span class="rounded-full border border-slate-200/80 bg-white/90 px-3 py-2 text-xs font-semibold text-slate-600">
              {skillLabels[skillId] ?? getSkillLabel(skillId)}
            </span>
          ))
      }
    </div>
  </div>

  <div class="mt-8 grid gap-5 lg:grid-cols-2">
    <div>
      <p
        class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
      >
        Why it mattered
      </p>
      <p class="mt-3 text-base leading-8 text-slate-600">{project.impact}</p>
    </div>
    <div>
      <p
        class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
      >
        What I built
      </p>
      <p class="mt-3 text-base leading-8 text-slate-600">{project.detail}</p>
    </div>
  </div>

  {
    project.proofLinks.length > 0 ? (
      <div class="mt-6 flex flex-wrap gap-3">
        {project.proofLinks.map((link) => (
          <a
            class="inline-flex items-center rounded-full border border-slate-200/80 bg-white/90 px-5 py-3 text-sm font-semibold text-[#0e1528] shadow-[0_10px_24px_rgba(31,44,75,0.06)] transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-white"
            href={link.href}
            rel="noreferrer"
            target="_blank"
          >
            {link.label}
          </a>
        ))}
      </div>
    ) : null
  }
</article>
