---
import type { ProjectPublicProof } from "@/lib/portfolio-types";

type Props = {
  proof: ProjectPublicProof;
};

const { proof } = Astro.props;

const proofTypeLabels: Record<
  ProjectPublicProof["proofTypes"][number],
  string
> = {
  article: "Article",
  metric: "Scale signal",
  "open-source-reference": "Open-source reference",
  "private-enterprise": "Internal enterprise system",
  "public-repo": "Public repo",
  "sanitized-diagram": "High-level architecture",
};

const proofLists = [
  { title: "Architecture shape", items: proof.architectureShape },
  { title: "Responsibilities", items: proof.responsibilities },
  { title: "Constraints", items: proof.constraints },
] as const;

const boundaryNote = proof.confidentialityNotes[0];
---

<section
  class="rounded-[1.8rem] border border-slate-200/80 bg-white/78 px-6 py-8 shadow-[0_18px_48px_rgba(31,44,75,0.06)] backdrop-blur-xl sm:px-8"
  id="proof"
>
  <div class="grid gap-6 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)]">
    <div>
      <p
        class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
      >
        What can be shown
      </p>
      <h2
        class="mt-4 font-display text-4xl font-semibold leading-tight tracking-[-0.045em] text-[#0e1528]"
      >
        Public evidence without internal names
      </h2>
      <p class="mt-5 text-base leading-8 text-slate-600">
        The internal systems stay private. This section keeps the public parts:
        my role, system boundaries, technology context, scale, decisions,
        constraints, and what I learned.
      </p>

      <div class="mt-6 flex flex-wrap gap-2">
        {
          proof.proofTypes.map((proofType) => (
            <span class="rounded-full border border-slate-200/80 bg-white/90 px-3 py-2 text-xs font-semibold text-[#1f3b73]">
              {proofTypeLabels[proofType]}
            </span>
          ))
        }
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      {
        proof.scaleSignals.map((signal) => (
          <article class="rounded-[1.5rem] border border-slate-200/80 bg-white/80 px-5 py-5">
            <p class="font-mono text-[0.68rem] uppercase tracking-[0.2em] text-[#1f3b73]">
              {signal.label}
            </p>
            <p class="mt-3 text-3xl font-semibold tracking-tight text-[#0e1528]">
              {signal.value}
            </p>
            <p class="mt-2 text-sm leading-7 text-slate-600">{signal.detail}</p>
          </article>
        ))
      }
    </div>
  </div>

  <div class="mt-8 grid gap-5 lg:grid-cols-3">
    {
      proofLists.map((list) => (
        <article class="rounded-[1.5rem] border border-slate-200/80 bg-white/72 px-5 py-5">
          <h3 class="text-lg font-semibold tracking-tight text-[#0e1528]">
            {list.title}
          </h3>
          <ul class="mt-4 space-y-3 text-sm leading-7 text-slate-600">
            {list.items.map((item) => (
              <li class="flex gap-3">
                <span class="mt-[0.65rem] h-2 w-2 shrink-0 rounded-full bg-[#1f3b73]" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </article>
      ))
    }
  </div>

  {
    proof.artifacts.length > 0 ? (
      <div class="mt-8">
        <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]">
          Supporting context
        </p>
        <div class="mt-4 grid gap-4 md:grid-cols-2">
          {proof.artifacts.map((artifact) => {
            const body = (
              <>
                <p class="text-xs font-semibold uppercase tracking-[0.18em] text-[#1f3b73]">
                  {proofTypeLabels[artifact.type]}
                </p>
                <h3 class="mt-3 text-xl font-semibold tracking-tight text-[#0e1528]">
                  {artifact.label}
                </h3>
                <p class="mt-3 text-sm leading-7 text-slate-600">
                  {artifact.detail}
                </p>
              </>
            );

            return artifact.href ? (
              <a
                class="block rounded-[1.5rem] border border-slate-200/80 bg-white/80 px-5 py-5 transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-white"
                href={artifact.href}
                rel="noreferrer"
                target="_blank"
              >
                {body}
              </a>
            ) : (
              <article class="rounded-[1.5rem] border border-slate-200/80 bg-white/80 px-5 py-5">
                {body}
              </article>
            );
          })}
        </div>
      </div>
    ) : null
  }

  {
    boundaryNote ? (
      <aside class="mt-8 rounded-[1.5rem] border border-slate-200/80 bg-white/72 px-5 py-5">
        <p class="text-sm font-semibold text-[#0e1528]">Boundary</p>
        <p class="mt-3 text-sm leading-7 text-slate-600">{boundaryNote}</p>
      </aside>
    ) : null
  }
</section>
