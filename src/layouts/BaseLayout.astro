---
import { siteProfile } from "@/content/portfolio";
import "@/src/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  showAdminNav?: boolean;
  showRouteHeader?: boolean;
};

const {
  title = siteProfile.name,
  description = "Portfolio, resume, and selected work for Vijay Jangir across data platforms, backend systems, and streaming infrastructure.",
  showAdminNav = false,
  showRouteHeader = true,
} = Astro.props;

const routeNavItems = [
  { href: "/", label: "Home" },
  { href: "/resume", label: "Resume" },
  { href: "/work", label: "Work" },
  { href: "/blog", label: "Blog" },
];

if (showAdminNav) {
  routeNavItems.push({ href: "/admin", label: "Admin" });
}

const pathname = Astro.url.pathname;
---

<!doctype html>
<html class="scroll-smooth" lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content={description} name="description" />
    <meta content={siteProfile.name} property="og:site_name" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta
      content={new URL(Astro.url.pathname, Astro.site).toString()}
      property="og:url"
    />
    <meta content="website" property="og:type" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <link
      href={new URL(Astro.url.pathname, Astro.site).toString()}
      rel="canonical"
    />
    <link href="https://fonts.googleapis.com" rel="preconnect" />
    <link crossorigin href="https://fonts.gstatic.com" rel="preconnect" />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Sora:wght@500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body
    class="min-h-screen bg-[radial-gradient(circle_at_18%_10%,rgba(176,177,255,0.34),transparent_28%),radial-gradient(circle_at_85%_8%,rgba(255,214,223,0.42),transparent_24%),radial-gradient(circle_at_50%_72%,rgba(255,255,255,0.82),transparent_38%),linear-gradient(180deg,#fbfbff_0%,#f6f7fe_48%,#ffffff_100%)] font-[Manrope] text-[#0e1528] antialiased"
  >
    <a
      class="absolute left-4 top-4 z-50 -translate-y-20 rounded-full bg-[#11192c] px-4 py-3 text-sm font-semibold text-white shadow-[0_14px_32px_rgba(17,25,44,0.2)] transition focus:translate-y-0"
      href="#main-content"
    >
      Skip to content
    </a>
    {
      showRouteHeader ? (
        <header class="fixed inset-x-0 top-4 z-40 flex justify-center px-4">
          <div class="inline-flex max-w-full items-center gap-1 overflow-x-auto rounded-full border border-white/70 bg-white/80 p-2 shadow-[0_18px_46px_rgba(31,44,75,0.08)] backdrop-blur-xl">
            <a
              class="shrink-0 px-3 py-2 text-sm font-bold tracking-tight text-[#0e1528]"
              href="/"
            >
              {siteProfile.name}
            </a>
            {routeNavItems.map((item) => {
              const active = pathname === item.href;
              return (
                <a
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "shrink-0 rounded-full px-4 py-2 text-sm font-semibold transition",
                    active
                      ? "bg-white text-[#0e1528] shadow-[0_6px_18px_rgba(31,44,75,0.08)]"
                      : "text-slate-500 hover:bg-white/80 hover:text-[#0e1528]",
                  ]}
                  href={item.href}
                >
                  {item.label}
                </a>
              );
            })}
          </div>
        </header>
      ) : null
    }

    <div
      id="main-content"
      class:list={[
        "mx-auto w-full max-w-[84rem] px-4",
        showRouteHeader ? "pt-28" : "pt-0",
      ]}
    >
      <slot />

      <footer class="pb-10 pt-8 text-sm text-slate-500">
        <div
          class="rounded-[2rem] border border-white/70 bg-white/65 px-6 py-6 shadow-[0_18px_46px_rgba(31,44,75,0.06)] backdrop-blur-xl sm:px-8"
        >
          <div
            class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between"
          >
            <div class="max-w-2xl">
              <p
                class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
              >
                About this site
              </p>
              <p class="mt-3 text-base leading-7 text-slate-600">
                Built to make a strong first impression, hold up under a closer
                read, and stay current over time.
              </p>
              <p class="mt-3 text-sm leading-7 text-slate-500">
                Last updated {siteProfile.lastUpdatedLabel}.{" "}
                {siteProfile.contentPromise}
              </p>
            </div>
            <div class="flex flex-wrap gap-5">
              <a
                class="font-semibold hover:text-[#0e1528]"
                href={siteProfile.githubUrl}
                rel="noreferrer"
                target="_blank"
              >
                GitHub
              </a>
              <a
                class="font-semibold hover:text-[#0e1528]"
                href={siteProfile.linkedinUrl}
                rel="noreferrer"
                target="_blank"
              >
                LinkedIn
              </a>
              <a
                class="font-semibold hover:text-[#0e1528]"
                href={`mailto:${siteProfile.email}`}
              >
                {siteProfile.email}
              </a>
            </div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
