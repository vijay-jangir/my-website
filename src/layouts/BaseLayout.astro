---
import { getPortfolioContent } from "@/lib/portfolio-content";
import type { SiteProfile } from "@/lib/portfolio-types";
import { buildPersonJsonLd } from "@/src/lib/jsonld";
import { buildTypographyCssVariables } from "@/src/config/typography";
import "@/src/styles/global.css";

export const nonPublicRobotsContent = "noindex, noarchive";

export const setRobotsHeader = (
  headers: Headers,
  robotsContent = nonPublicRobotsContent,
) => {
  headers.set("X-Robots-Tag", robotsContent);
};

type Props = {
  description?: string;
  nonPublic?: boolean;
  ogType?: "website" | "article";
  robots?: string;
  siteProfile?: SiteProfile;
  showAdminNav?: boolean;
  showRouteHeader?: boolean;
  socialImageAlt?: string;
  socialImagePath?: string;
  title?: string;
};

const {
  description = "Portfolio, resume, and selected work for Vijay Jangir across data platforms, backend systems, and streaming infrastructure.",
  nonPublic = false,
  ogType = "website",
  robots: robotsOverride,
  siteProfile: siteProfileOverride,
  showAdminNav = false,
  showRouteHeader = true,
  socialImageAlt = "Profile photo of Vijay Jangir",
  socialImagePath = "/og-preview.jpg",
  title: titleOverride,
} = Astro.props;

const siteProfile =
  siteProfileOverride ?? (await getPortfolioContent()).siteProfile;
const title = titleOverride ?? siteProfile.name;
const typographyCssVariables = buildTypographyCssVariables();
const siteBase = Astro.site ?? Astro.url;
const canonicalUrl = new URL(Astro.url.pathname, siteBase).toString();
const socialImageUrl = new URL(socialImagePath, siteBase).toString();
const robotsContent =
  robotsOverride ?? (nonPublic ? nonPublicRobotsContent : "");

if (robotsContent) {
  setRobotsHeader(Astro.response.headers, robotsContent);
}

const personJsonLd = JSON.stringify(
  buildPersonJsonLd({
    baseUrl: siteBase,
    description,
    fallbackImagePath: socialImagePath,
    siteProfile,
  }),
);

const routeNavItems = [
  { href: "/", label: "Vijay", activeOn: ["/"] },
  { href: "/projects", label: "Work", activeOn: ["/projects", "/work"] },
  { href: "/resume", label: "Resume", activeOn: ["/resume"] },
  { href: "/blog", label: "Blog", activeOn: ["/blog"] },
  { href: "/#contact", label: "Contact", activeOn: [] },
];

if (showAdminNav) {
  routeNavItems.push({ href: "/admin", label: "Admin", activeOn: ["/admin"] });
}

const pathname = Astro.url.pathname;
---

<!doctype html>
<html class="scroll-smooth" lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <meta content={description} name="description" />
    {robotsContent ? <meta content={robotsContent} name="robots" /> : null}
    <link href="/favicon.ico" rel="icon" sizes="any" />
    <link href="/favicon.png" rel="icon" type="image/png" />
    <link href="/favicon.png" rel="apple-touch-icon" />
    <link
      href={new URL("/rss.xml", siteBase).toString()}
      rel="alternate"
      title={`${siteProfile.name} | Blog`}
      type="application/rss+xml"
    />
    <meta content={siteProfile.name} property="og:site_name" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={canonicalUrl} property="og:url" />
    <meta content={ogType} property="og:type" />
    <meta content={socialImageUrl} property="og:image" />
    <meta content={socialImageAlt} property="og:image:alt" />
    <meta content="1200" property="og:image:width" />
    <meta content="630" property="og:image:height" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content={title} name="twitter:title" />
    <meta content={description} name="twitter:description" />
    <meta content={socialImageUrl} name="twitter:image" />
    <meta content={socialImageAlt} name="twitter:image:alt" />
    <link href={canonicalUrl} rel="canonical" />
    <script is:inline set:html={personJsonLd} type="application/ld+json" />
    <slot name="head" />
    <title>{title}</title>
    <noscript>
      <style>
        [style*="opacity:0"], [style*="opacity: 0"] {
          opacity: 1 !important;
          transform: none !important;
          filter: none !important;
        }
      </style>
    </noscript>
  </head>
  <body
    class="min-h-screen bg-[radial-gradient(circle_at_12%_0%,rgba(59,130,246,0.11),transparent_26%),radial-gradient(circle_at_90%_4%,rgba(20,184,166,0.10),transparent_24%),linear-gradient(180deg,#f8fafc_0%,#f5f7f6_48%,#ffffff_100%)] font-body text-[#0e1528] antialiased"
    style={typographyCssVariables}
  >
    <a
      class="absolute left-4 top-4 z-50 -translate-y-20 rounded-full bg-[#11192c] px-4 py-3 text-sm font-semibold text-white shadow-[0_14px_32px_rgba(17,25,44,0.2)] transition focus:translate-y-0"
      href="#main-content"
    >
      Skip to content
    </a>
    {
      showRouteHeader ? (
        <header class="site-route-header fixed inset-x-0 top-3 z-40 flex justify-center px-3 sm:top-4 sm:px-4">
          <div class="site-route-nav-shell flex max-w-full items-center gap-1 overflow-x-auto rounded-full border border-white/80 bg-white/88 p-1.5 shadow-[0_12px_30px_rgba(31,44,75,0.06)] backdrop-blur-xl sm:p-2">
            {routeNavItems.map((item, index) => {
              const active = item.activeOn.some(
                (activePath) =>
                  pathname === activePath ||
                  (activePath !== "/" && pathname.startsWith(`${activePath}/`)),
              );
              return (
                <a
                  aria-current={active ? "page" : undefined}
                  class:list={[
                    "site-route-nav-item",
                    "shrink-0 rounded-full px-3 py-2 text-sm font-semibold transition sm:px-4",
                    active
                      ? "bg-white text-[#0e1528] shadow-[0_6px_18px_rgba(31,44,75,0.08)]"
                      : "text-slate-500 hover:bg-white/80 hover:text-[#0e1528]",
                  ]}
                  href={item.href}
                  style={`--nav-index: ${index}`}
                >
                  {item.label}
                </a>
              );
            })}
          </div>
        </header>
      ) : null
    }

    <div
      id="main-content"
      class:list={[
        "mx-auto w-full max-w-[84rem] px-4",
        showRouteHeader ? "pt-32 sm:pt-28" : "pt-0",
      ]}
    >
      <slot />

      <footer class="pb-10 pt-8 text-sm text-slate-500">
        <div
          class="rounded-[2rem] border border-white/70 bg-white/65 px-6 py-6 shadow-[0_18px_46px_rgba(31,44,75,0.06)] backdrop-blur-xl sm:px-8"
        >
          <div
            class="flex flex-col gap-5 lg:flex-row lg:items-end lg:justify-between"
          >
            <div class="max-w-2xl">
              <p
                class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
              >
                {siteProfile.name}
              </p>
              <p class="mt-3 text-base leading-7 text-slate-600">
                Governed data platforms, enterprise AI, access governance,
                orchestration, CI/CD onboarding, and network-scale analytics.
              </p>
              <p class="mt-3 text-sm leading-7 text-slate-500">
                Last updated {siteProfile.lastUpdatedLabel}.{" "}
                {siteProfile.contentPromise}
              </p>
            </div>
            <div class="flex flex-wrap gap-5">
              <a
                class="font-semibold hover:text-[#0e1528]"
                href={siteProfile.githubUrl}
                rel="noreferrer"
                target="_blank"
              >
                GitHub
              </a>
              <a
                class="font-semibold hover:text-[#0e1528]"
                href={siteProfile.linkedinUrl}
                rel="noreferrer"
                target="_blank"
              >
                LinkedIn
              </a>
              <a
                class="font-semibold hover:text-[#0e1528]"
                href={`mailto:${siteProfile.email}`}
              >
                {siteProfile.email}
              </a>
            </div>
          </div>
        </div>
      </footer>
    </div>
  </body>
</html>
