---
import { focusDefinitions } from "@/content/portfolio";
import { isAuthConfigured } from "@/lib/env";
import ResumeLab from "@/src/components/admin/ResumeLab";
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import { getSessionUser } from "@/src/lib/auth";

const session = await getSessionUser(Astro.cookies);
const error = Astro.url.searchParams.get("error");
---

<BaseLayout
  description="Private resume tailoring and JD analysis tools."
  showAdminNav={true}
  title="Admin | Vijay Jangir"
>
  <main class="space-y-8 pb-4">
    <section
      class="rounded-[2.5rem] border border-white/70 bg-white/80 p-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:p-10"
    >
      <p
        class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
      >
        Private admin
      </p>
      <h1
        class="mt-4 font-['Sora'] text-4xl font-semibold tracking-[-0.045em] text-[#0e1528]"
      >
        Resume tailoring lab
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600">
        This surface stays private. Public visitors should never have direct
        access to JD parsing or assistant tooling.
      </p>

      {
        !isAuthConfigured() ? (
          <div class="mt-8 rounded-[1.75rem] border border-slate-200/80 bg-white/90 p-6">
            <p class="text-sm leading-7 text-slate-600">
              Add <code>NEXTAUTH_SECRET</code> or <code>SESSION_SECRET</code>,{" "}
              <code>GITHUB_ID</code>, <code>GITHUB_SECRET</code>, and{" "}
              <code>ADMIN_GITHUB_LOGINS</code> to enable private access in the
              next wave.
            </p>
          </div>
        ) : !session ? (
          <div class="mt-8 rounded-[1.75rem] border border-slate-200/80 bg-white/90 p-6">
            <p class="text-sm leading-7 text-slate-600">
              This route is restricted to manually allowlisted GitHub accounts.
            </p>
            {error ? (
              <p class="mt-4 rounded-[1.25rem] border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700">
                Sign-in failed: {error}.
              </p>
            ) : null}
            <div class="mt-6 flex flex-wrap gap-3">
              <a
                class="inline-flex items-center rounded-full bg-[#11192c] px-5 py-3 text-sm font-semibold text-white shadow-[0_14px_32px_rgba(17,25,44,0.16)] transition hover:-translate-y-0.5 hover:bg-[#0b1222]"
                href="/api/auth/github"
              >
                Sign in with GitHub
              </a>
            </div>
          </div>
        ) : null
      }
    </section>

    {
      session ? (
        <>
          <section class="rounded-[2rem] border border-white/70 bg-white/80 p-6 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl">
            <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-sm font-semibold text-[#0e1528]">
                  Signed in as {session.login}
                </p>
                <p class="mt-1 text-sm text-slate-500">Role: {session.role}</p>
              </div>
              <a
                class="inline-flex items-center rounded-full border border-slate-200/80 bg-white/90 px-4 py-2 text-sm font-semibold text-[#0e1528] transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-white"
                href="/api/auth/logout"
              >
                Sign out
              </a>
            </div>
          </section>

          <ResumeLab client:load focusOptions={focusDefinitions} />
        </>
      ) : null
    }
  </main>
</BaseLayout>
