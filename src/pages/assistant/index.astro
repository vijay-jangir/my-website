---
import BaseLayout, { setRobotsHeader } from "@/src/layouts/BaseLayout.astro";
import { getSessionUser } from "@/src/lib/auth";
import { getPortfolioContent } from "@/lib/portfolio-content";

const content = await getPortfolioContent();
const session = await getSessionUser(Astro.cookies);

// Defense-in-depth: middleware already guards this route, but set the
// header here as well so it cannot be forgotten if middleware changes.
setRobotsHeader(Astro.response.headers);

const tools = [
  {
    href: "/admin",
    title: "Resume Lab",
    description:
      "JD-driven resume tailoring, ATS-safe PDF export, and variant management.",
    status: "Live",
  },
  {
    href: "#",
    title: "Content Studio",
    description:
      "AI-assisted editing for portfolio copy, project writeups, and profile data.",
    status: "Phase 6",
  },
  {
    href: "#",
    title: "Market Signals",
    description:
      "Private market intelligence loop for role tracking and opportunity matching.",
    status: "Phase 7",
  },
];
---

<BaseLayout
  description="Private tools dashboard for resume generation, content editing, and market intelligence."
  nonPublic={true}
  showAdminNav={true}
  siteProfile={content.siteProfile}
  title="Tools | Vijay Jangir"
>
  <main class="space-y-8 pb-4">
    <section
      class="rounded-[2.5rem] border border-white/70 bg-white/80 p-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:p-10"
    >
      <p
        class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
      >
        Private surface
      </p>
      <h1
        class="mt-4 font-display text-4xl font-semibold tracking-[-0.045em] text-[#0e1528]"
      >
        Tools
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600">
        Private workspace for resume generation, content editing, and market
        intelligence. Each tool operates behind authentication and never exposes
        draft artifacts publicly.
      </p>
      {
        session ? (
          <p class="mt-3 text-sm text-slate-500">
            Signed in as {session.login}.
          </p>
        ) : null
      }
    </section>

    <section class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        tools.map((tool) => {
          const isPlaceholder = tool.href === "#";
          return isPlaceholder ? (
            <div
              class="flex flex-col rounded-[2rem] border border-white/70 bg-white/80 p-6 opacity-60 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl"
            >
              <div class="flex items-center justify-between">
                <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]">
                  {tool.title}
                </p>
                <span class="rounded-full bg-slate-100 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wider text-slate-500">
                  {tool.status}
                </span>
              </div>
              <p class="mt-4 text-sm leading-7 text-slate-600">
                {tool.description}
              </p>
            </div>
          ) : (
            <a
              class="group flex flex-col rounded-[2rem] border border-white/70 bg-white/80 p-6 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl transition hover:-translate-y-0.5 hover:shadow-[0_24px_64px_rgba(31,44,75,0.10)]"
              href={tool.href}
            >
              <div class="flex items-center justify-between">
                <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]">
                  {tool.title}
                </p>
                <span class="rounded-full bg-emerald-50 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wider text-emerald-700">
                  {tool.status}
                </span>
              </div>
              <p class="mt-4 text-sm leading-7 text-slate-600">
                {tool.description}
              </p>
              <span class="mt-auto inline-flex items-center gap-1 pt-5 text-sm font-semibold text-[#1f3b73]">
                Open
                <svg
                  class="h-4 w-4 transition group-hover:translate-x-1"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  viewBox="0 0 24 24"
                >
                  <path
                    d="M5 12h14M12 5l7 7-7 7"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </span>
            </a>
          );
        })
      }
    </section>
  </main>
</BaseLayout>
