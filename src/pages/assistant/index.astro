---
import BaseLayout from "@/src/layouts/BaseLayout.astro";
---

<BaseLayout
  description="Private assistant surface reserved for future OpenClaw integration."
  title="Assistant | Vijay Jangir"
>
  <main class="pb-4">
    <section
      class="rounded-[2.5rem] border border-white/70 bg-white/80 p-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:p-10"
    >
      <p
        class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
      >
        Future private surface
      </p>
      <h1
        class="mt-4 font-['Sora'] text-4xl font-semibold tracking-[-0.045em] text-[#0e1528]"
      >
        Assistant
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600">
        This route is reserved for a private assistant experience. OpenClaw
        itself should stay off Vercel and behind a dedicated homelab or VPS
        surface, with the website talking only to a restricted HTTP bridge
        later.
      </p>
    </section>
  </main>
</BaseLayout>
