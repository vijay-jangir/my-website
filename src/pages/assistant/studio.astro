---
import BaseLayout, { setRobotsHeader } from "@/src/layouts/BaseLayout.astro";
import { getSessionUser } from "@/src/lib/auth";
import { getPortfolioContent } from "@/lib/portfolio-content";
import { isLlmConfigured } from "@/lib/llm/index";
import {
  recommendTopics,
  type PublishedPost,
  type TopicEngineInput,
} from "@/lib/studio/topics";

const content = await getPortfolioContent();
const session = await getSessionUser(Astro.cookies);

setRobotsHeader(Astro.response.headers);

const llmAvailable = isLlmConfigured();

const publishedPosts: PublishedPost[] = content.projects
  .filter((p) => p.visibility === "public")
  .map((p) => ({
    slug: p.slug,
    title: p.title,
    tags: p.skillIds,
  }));

const input: TopicEngineInput = {
  focuses: content.focusDefinitions,
  skills: content.skillDefinitions,
  publishedPosts,
};

const suggestions = recommendTopics(input);
---

<BaseLayout
  description="Content studio for blog topic recommendations and AI-assisted drafting."
  nonPublic={true}
  showAdminNav={true}
  siteProfile={content.siteProfile}
  title="Content Studio | Vijay Jangir"
>
  <main class="space-y-8 pb-4">
    <section
      class="rounded-[2.5rem] border border-white/70 bg-white/80 p-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:p-10"
    >
      <p
        class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
      >
        Content Studio
      </p>
      <h1
        class="mt-4 font-display text-4xl font-semibold tracking-[-0.045em] text-[#0e1528]"
      >
        Blog Topics & Drafting
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600">
        Topic suggestions are generated deterministically from your focus areas, skills,
        and published content. Pick a topic, supply your notes, and the AI drafts a
        structured post for your review.
      </p>
      {session ? (
        <p class="mt-3 text-sm text-slate-500">
          Signed in as {session.login}.
        </p>
      ) : null}

      {!llmAvailable ? (
        <div class="mt-4 rounded-xl border border-amber-200 bg-amber-50 px-4 py-3 text-sm text-amber-800">
          <strong>AI enrichment unavailable.</strong> No LLM provider is configured.
          Topic recommendations are available (deterministic). Blog drafting requires an LLM.
        </div>
      ) : null}
    </section>

    <!-- Topic Recommendations -->
    <section
      class="rounded-[2.5rem] border border-white/70 bg-white/80 p-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:p-10"
    >
      <h2 class="font-display text-2xl font-semibold tracking-[-0.03em] text-[#0e1528]">
        Recommended Topics
      </h2>
      <p class="mt-2 text-sm text-slate-500">
        {suggestions.length} suggestions ranked by visibility signal.
      </p>

      {suggestions.length === 0 ? (
        <p class="mt-6 text-slate-500">
          No topic gaps found — all focus areas and skills have published coverage.
        </p>
      ) : (
        <div class="mt-6 space-y-4">
          {suggestions.map((topic) => (
            <div
              class="group rounded-2xl border border-slate-200 bg-white p-5 transition hover:shadow-md"
              data-topic-card
              data-topic-id={topic.id}
              data-topic-title={topic.workingTitle}
              data-topic-keywords={topic.targetKeywords.join(",")}
            >
              <div class="flex items-start justify-between gap-4">
                <div class="min-w-0 flex-1">
                  <h3 class="font-semibold text-[#0e1528]">{topic.workingTitle}</h3>
                  <p class="mt-1 text-sm leading-6 text-slate-600">{topic.rationale}</p>
                  <p class="mt-2 text-sm italic text-slate-500">{topic.suggestedAngle}</p>
                  <div class="mt-3 flex flex-wrap gap-1.5">
                    {topic.targetKeywords.map((kw) => (
                      <span class="rounded-full bg-slate-100 px-2.5 py-0.5 text-[0.7rem] font-medium text-slate-600">
                        {kw}
                      </span>
                    ))}
                  </div>
                </div>
                <div class="flex shrink-0 flex-col items-end gap-2">
                  <span class="rounded-full bg-blue-50 px-2.5 py-1 text-[0.65rem] font-semibold uppercase tracking-wider text-blue-700">
                    {topic.signal}
                  </span>
                  <span class="text-xs font-semibold text-slate-400">
                    score {topic.score}
                  </span>
                </div>
              </div>
              {llmAvailable ? (
                <button
                  class="mt-4 rounded-lg bg-[#1f3b73] px-4 py-2 text-sm font-semibold text-white opacity-0 transition group-hover:opacity-100 hover:bg-[#162b56]"
                  data-draft-trigger
                  data-topic-title={topic.workingTitle}
                  data-topic-keywords={topic.targetKeywords.join(",")}
                  data-topic-focus={topic.signal === "focus-gap" ? topic.id.replace("focus-gap-", "") : ""}
                  type="button"
                >
                  Draft this topic
                </button>
              ) : null}
            </div>
          ))}
        </div>
      )}
    </section>

    <!-- Drafting Panel (hidden until topic selected) -->
    {llmAvailable ? (
      <section
        class="hidden rounded-[2.5rem] border border-white/70 bg-white/80 p-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:p-10"
        id="draft-panel"
      >
        <h2 class="font-display text-2xl font-semibold tracking-[-0.03em] text-[#0e1528]">
          Draft a Post
        </h2>
        <p class="mt-2 text-sm text-slate-500" id="draft-topic-label">
          Select a topic above or enter your own.
        </p>

        <form class="mt-6 space-y-5" id="draft-form">
          <div>
            <label class="block text-sm font-semibold text-slate-700" for="draft-title">
              Title
            </label>
            <input
              class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-[#0e1528] placeholder-slate-400 focus:border-[#1f3b73] focus:outline-none focus:ring-1 focus:ring-[#1f3b73]"
              id="draft-title"
              name="title"
              placeholder="Working title for the post"
              required
              type="text"
            />
          </div>
          <div>
            <label class="block text-sm font-semibold text-slate-700" for="draft-notes">
              Your Notes
            </label>
            <p class="mt-0.5 text-xs text-slate-500">
              Bullet points, facts, links, code snippets — the AI will draft from these only.
            </p>
            <textarea
              class="mt-1.5 h-48 w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-[#0e1528] placeholder-slate-400 focus:border-[#1f3b73] focus:outline-none focus:ring-1 focus:ring-[#1f3b73]"
              id="draft-notes"
              name="ownerNotes"
              placeholder="- Key point 1&#10;- Technical detail&#10;- Link to reference"
              required
            ></textarea>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            <div>
              <label class="block text-sm font-semibold text-slate-700" for="draft-keywords">
                Keywords (comma-separated)
              </label>
              <input
                class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-[#0e1528] placeholder-slate-400 focus:border-[#1f3b73] focus:outline-none focus:ring-1 focus:ring-[#1f3b73]"
                id="draft-keywords"
                name="keywords"
                placeholder="keyword1, keyword2"
                type="text"
              />
            </div>
            <div>
              <label class="block text-sm font-semibold text-slate-700" for="draft-focus">
                Focus Area
              </label>
              <input
                class="mt-1.5 w-full rounded-lg border border-slate-300 bg-white px-3.5 py-2.5 text-sm text-[#0e1528] placeholder-slate-400 focus:border-[#1f3b73] focus:outline-none focus:ring-1 focus:ring-[#1f3b73]"
                id="draft-focus"
                name="focusArea"
                placeholder="e.g. backend-engineering"
                type="text"
              />
            </div>
          </div>
          <div class="flex items-center gap-4">
            <button
              class="rounded-lg bg-[#1f3b73] px-5 py-2.5 text-sm font-semibold text-white hover:bg-[#162b56] disabled:cursor-not-allowed disabled:opacity-50"
              id="draft-submit"
              type="submit"
            >
              Generate Draft
            </button>
            <span class="hidden text-sm text-slate-500" id="draft-status">
              Generating...
            </span>
          </div>
        </form>

        <div class="mt-6 hidden rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800" id="draft-result">
          <p class="font-semibold">Draft created!</p>
          <p class="mt-1" id="draft-result-path"></p>
          <p class="mt-1 text-xs text-emerald-600">
            The file is saved with <code>draft: true</code>. Edit it and flip to
            <code>draft: false</code> when ready to publish. Nothing auto-publishes.
          </p>
        </div>

        <div class="mt-6 hidden rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800" id="draft-error">
        </div>
      </section>
    ) : null}
  </main>
</BaseLayout>

<script>
  const triggers = document.querySelectorAll("[data-draft-trigger]");
  const draftPanel = document.getElementById("draft-panel");
  const draftForm = document.getElementById("draft-form");
  const draftTitle = document.getElementById("draft-title");
  const draftKeywords = document.getElementById("draft-keywords");
  const draftFocus = document.getElementById("draft-focus");
  const draftTopicLabel = document.getElementById("draft-topic-label");
  const draftSubmit = document.getElementById("draft-submit");
  const draftStatus = document.getElementById("draft-status");
  const draftResult = document.getElementById("draft-result");
  const draftResultPath = document.getElementById("draft-result-path");
  const draftError = document.getElementById("draft-error");

  for (const trigger of triggers) {
    trigger.addEventListener("click", () => {
      if (!draftPanel || !draftTitle || !draftKeywords || !draftFocus || !draftTopicLabel) return;

      const title = trigger.getAttribute("data-topic-title") ?? "";
      const keywords = trigger.getAttribute("data-topic-keywords") ?? "";
      const focus = trigger.getAttribute("data-topic-focus") ?? "";

      draftPanel.classList.remove("hidden");
      draftTitle.value = title;
      draftKeywords.value = keywords;
      draftFocus.value = focus;
      draftTopicLabel.textContent = `Drafting: ${title}`;

      draftPanel.scrollIntoView({ behavior: "smooth", block: "start" });
    });
  }

  draftForm?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (!draftSubmit || !draftStatus || !draftResult || !draftError || !draftTitle) return;

    draftSubmit.disabled = true;
    draftStatus.classList.remove("hidden");
    draftResult.classList.add("hidden");
    draftError.classList.add("hidden");

    const formData = new FormData(draftForm);
    const keywordsRaw = String(formData.get("keywords") ?? "");

    const payload = {
      title: String(formData.get("title") ?? ""),
      ownerNotes: String(formData.get("ownerNotes") ?? ""),
      keywords: keywordsRaw.split(",").map((k) => k.trim()).filter(Boolean),
      focusArea: String(formData.get("focusArea") ?? "") || undefined,
    };

    try {
      const response = await fetch("/api/studio/draft", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });

      const data = await response.json();

      if (data.ok) {
        draftResult.classList.remove("hidden");
        if (draftResultPath) {
          draftResultPath.textContent = `File: ${data.filePath} (slug: ${data.slug})`;
        }
      } else {
        draftError.classList.remove("hidden");
        draftError.textContent = data.message || "Draft generation failed.";
      }
    } catch (err) {
      draftError.classList.remove("hidden");
      draftError.textContent = "Network error — could not reach the drafting endpoint.";
    } finally {
      draftSubmit.disabled = false;
      draftStatus.classList.add("hidden");
    }
  });
</script>
