---
import { getPortfolioContent } from "@/lib/portfolio-content";
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import {
  WIX_BLOG_DETAIL_CACHE_CONTROL,
  getWixBlogDescription,
  getWixBlogParagraphs,
  getWixBlogPostBySlug,
  getWixBlogSourceUrl,
} from "@/src/lib/wix";

export const prerender = false;

const content = await getPortfolioContent();
const slug = Astro.params.slug ?? "";
const lookup = slug
  ? await getWixBlogPostBySlug(slug)
  : ({ status: "not_found" } as const);
const post = lookup.status === "ok" ? lookup.post : null;
const paragraphs = getWixBlogParagraphs(post?.contentText);
const description = post
  ? getWixBlogDescription(post)
  : "This Wix-authored blog post could not be loaded on the local detail route right now.";
const sourceUrl = post ? getWixBlogSourceUrl(post) : null;
const publishedLabel = formatDate(post?.firstPublishedDate);
const updatedLabel = formatDate(post?.lastPublishedDate);
const fallbackCopy = getFallbackCopy(lookup.status, slug);

Astro.response.headers.set(
  "Cache-Control",
  lookup.status === "ok" || lookup.status === "not_found"
    ? WIX_BLOG_DETAIL_CACHE_CONTROL
    : "no-store",
);

if (lookup.status === "not_found") {
  Astro.response.status = 404;
} else if (lookup.status !== "ok") {
  Astro.response.status = 503;
}

function formatDate(value?: string) {
  if (!value) {
    return null;
  }

  return new Date(value).toLocaleDateString("en-US", {
    day: "numeric",
    month: "long",
    year: "numeric",
  });
}

function getFallbackCopy(status: typeof lookup.status, requestedSlug: string) {
  switch (status) {
    case "missing_credentials":
      return "Wix API credentials are not configured in this environment yet, so the local detail page shows a safe fallback instead of failing.";
    case "error":
      return "Wix returned an unexpected response for this post, so the route stays stable and lets readers return to the blog index.";
    case "not_found":
      return `No Wix-backed blog post matched the slug “${requestedSlug}”.`;
    default:
      return "";
  }
}
---

<BaseLayout
  description={description}
  siteProfile={content.siteProfile}
  title={post ? `${post.title} | Vijay Jangir` : "Blog post | Vijay Jangir"}
>
  <main class="space-y-10 pb-4">
    <section
      class="rounded-[2.6rem] border border-white/70 bg-white/80 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:px-10 sm:py-10"
    >
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_21rem] lg:items-end">
        <div>
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Writing
          </p>
          <h1
            class="mt-4 font-display text-4xl font-semibold leading-[0.98] tracking-[-0.05em] text-[#0e1528] sm:text-5xl"
          >
            {post ? post.title : "Blog post unavailable"}
          </h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">
            {post ? description : fallbackCopy}
          </p>
        </div>

        <div class="rounded-[2rem] bg-white/60 px-5 py-5">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Route status
          </p>
          {
            post ? (
              <div class="mt-3 space-y-2 text-sm leading-7 text-slate-600">
                <p>
                  Served from a cached Astro/Vercel route while Wix stays the
                  source of truth.
                </p>
                {publishedLabel ? <p>Published {publishedLabel}.</p> : null}
                {updatedLabel && updatedLabel !== publishedLabel ? (
                  <p>Updated {updatedLabel}.</p>
                ) : null}
                {post.minutesToRead ? (
                  <p>{post.minutesToRead} minute read.</p>
                ) : null}
              </div>
            ) : (
              <p class="mt-3 text-sm leading-7 text-slate-600">
                The route stays stable even when the requested Wix content is
                missing or unavailable.
              </p>
            )
          }
        </div>
      </div>
    </section>

    {
      post ? (
        <>
          <article class="rounded-[2rem] border border-white/70 bg-white/80 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.06)] backdrop-blur-xl sm:px-10">
            <div class="max-w-3xl space-y-6">
              {paragraphs.length > 0 ? (
                paragraphs.map((paragraph) => (
                  <p class="text-lg leading-8 text-slate-700">{paragraph}</p>
                ))
              ) : (
                <p class="text-lg leading-8 text-slate-700">
                  Wix returned the post metadata, but the body content was empty
                  in this response. The local route still renders a stable page
                  while keeping Wix as the source of truth.
                </p>
              )}
            </div>
          </article>

          <section class="rounded-[2rem] border border-white/70 bg-white/72 px-6 py-6 shadow-[0_18px_54px_rgba(31,44,75,0.06)] backdrop-blur-xl sm:px-8">
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-sm font-semibold text-[#1f3b73]">
                  Original source
                </p>
                <p class="mt-2 max-w-2xl text-sm leading-7 text-slate-600">
                  This on-domain detail page mirrors Wix-authored content for
                  readers and crawlers, with the original source still available
                  when it adds context.
                </p>
              </div>

              {sourceUrl ? (
                <a
                  class="inline-flex items-center justify-center rounded-full border border-[#1f3b73]/20 px-5 py-3 text-sm font-semibold text-[#1f3b73] transition hover:border-[#1f3b73] hover:bg-white"
                  href={sourceUrl}
                  rel="noreferrer"
                  target="_blank"
                >
                  View original on Wix
                </a>
              ) : null}
            </div>
          </section>
        </>
      ) : (
        <section class="rounded-[2rem] border border-white/70 bg-white/72 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.06)] backdrop-blur-xl sm:px-8">
          <p class="max-w-3xl text-base leading-8 text-slate-600">
            {fallbackCopy}
          </p>

          <div class="mt-6 flex flex-wrap gap-3">
            <a
              class="inline-flex items-center justify-center rounded-full bg-[#0e1528] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#17213a]"
              href="/blog"
            >
              Back to the blog index
            </a>
          </div>
        </section>
      )
    }
  </main>
</BaseLayout>
