---
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import BlogCard from "@/src/components/BlogCard.astro";
import { getWixBlogs } from "@/src/lib/wix";
import { getPortfolioContent } from "@/lib/portfolio-content";

const posts = await getWixBlogs();
const content = await getPortfolioContent();
---

<BaseLayout
  description="Writing, architecture notes, and long-form technical posts from Vijay Jangir."
  siteProfile={content.siteProfile}
  title="Blog | Vijay Jangir"
>
  <main class="space-y-10 pb-4">
    <section
      class="rounded-[2.6rem] border border-white/70 bg-white/80 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:px-10 sm:py-10"
    >
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_21rem] lg:items-end">
        <div>
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Writing
          </p>
          <h1
            class="mt-4 font-display text-5xl font-semibold leading-[0.96] tracking-[-0.05em] text-[#0e1528] sm:text-6xl"
          >
            Blog
          </h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">
            Posts are published on Wix and listed here.
          </p>
        </div>

        <div class="rounded-[2rem] bg-white/60 px-5 py-5">
          <p
            class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Updated
          </p>
          <p class="mt-3 text-sm leading-7 text-slate-600">
            Profile content was refreshed {
              content.siteProfile.lastUpdatedLabel
            }. Blog posts are fetched from Wix when credentials are configured.
          </p>
        </div>
      </div>
    </section>

    {
      posts.length === 0 ? (
        <section class="rounded-[2rem] border border-white/70 bg-white/72 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.06)] backdrop-blur-xl">
          <p class="text-base leading-8 text-slate-600">
            No posts are available right now, or the Wix API credentials are not
            configured yet.
          </p>
        </section>
      ) : (
        <section class="grid gap-4 md:grid-cols-2">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </section>
      )
    }
  </main>
</BaseLayout>
