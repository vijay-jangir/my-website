---
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import BlogCard from "@/src/components/BlogCard.astro";
import { getWixBlogs } from "@/src/lib/wix";

const posts = await getWixBlogs();
---

<BaseLayout
  description="Writing, architecture notes, and long-form technical posts from Vijay Jangir."
  title="Blog | Vijay Jangir"
>
  <main class="mt-10 space-y-8 sm:mt-14">
    <section class="glass-panel rounded-[2.5rem] p-8 sm:p-10">
      <p class="eyebrow text-xs text-[var(--muted)]">Writing</p>
      <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
        Blog
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-8 text-[var(--muted)]">
        Long-form writing stays on Wix for now. This page keeps discovery,
        context, and branding on your domain while the posts themselves open on
        the blog host.
      </p>
    </section>

    {
      posts.length === 0 ? (
        <section class="glass-panel rounded-[2rem] p-8">
          <p class="text-base leading-8 text-[var(--muted)]">
            No blog posts are available yet, or the Wix API credentials are not
            configured.
          </p>
        </section>
      ) : (
        <section class="grid gap-4 md:grid-cols-2">
          {posts.map((post) => (
            <BlogCard post={post} />
          ))}
        </section>
      )
    }
  </main>
</BaseLayout>
