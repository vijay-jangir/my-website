---
import {
  focusDefinitions,
  profileHighlights,
  siteProfile,
  skillDefinitions,
  experiences,
} from "@/content/portfolio";
import { getPublicProjects } from "@/lib/portfolio";
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import FocusPills from "@/src/components/FocusPills.astro";
import ProjectCard from "@/src/components/ProjectCard.astro";

const featuredProjects = getPublicProjects()
  .filter((project) => project.featured)
  .slice(0, 3);
const highlightedFocuses = focusDefinitions
  .filter((focus) => focus.id !== "general")
  .slice(0, 6);
const topSkills = skillDefinitions.slice(0, 12);
---

<BaseLayout>
  <main class="mt-10 space-y-8 sm:mt-14">
    <section class="grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_20rem]">
      <div class="glass-panel rounded-[2.5rem] p-8 sm:p-10">
        <p class="eyebrow text-xs text-[var(--muted)]">Recruiter fast path</p>
        <h1
          class="mt-5 max-w-4xl text-4xl font-semibold tracking-tight sm:text-6xl"
        >
          {siteProfile.heroLabel}
        </h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-[var(--muted)]">
          {siteProfile.recruiterPitch}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            class="rounded-full bg-[var(--ink)] px-5 py-3 text-sm font-semibold text-white hover:opacity-90"
            href="/resume"
          >
            Open focused resume
          </a>
          <a
            class="rounded-full border border-[var(--line)] px-5 py-3 text-sm font-semibold hover:border-[var(--accent)] hover:bg-[var(--accent-soft)]"
            href="/work"
          >
            Browse selected work
          </a>
          <a
            class="rounded-full border border-[var(--line)] px-5 py-3 text-sm font-semibold hover:border-[var(--accent)] hover:bg-[var(--accent-soft)]"
            href="/blog"
          >
            Read the blog
          </a>
        </div>

        <div class="mt-10">
          <p class="eyebrow text-xs text-[var(--muted)]">Change the emphasis</p>
          <div class="mt-4">
            <FocusPills
              activeFocusIds={["general"]}
              basePath="/resume"
              focusOptions={highlightedFocuses}
            />
          </div>
        </div>
      </div>

      <aside class="glass-panel rounded-[2.5rem] p-6">
        <img
          alt={`${siteProfile.name} profile`}
          class="h-32 w-32 rounded-[1.75rem] object-cover"
          src="/profile-pic.jpeg"
        />
        <h2 class="mt-5 text-2xl font-semibold tracking-tight">
          {siteProfile.name}
        </h2>
        <p class="mt-2 text-sm leading-6 text-[var(--muted)]">
          {siteProfile.title}
          <br />
          {siteProfile.location} · {siteProfile.timezone}
        </p>
        <div class="mt-6 flex flex-col gap-3 text-sm font-semibold">
          <a
            class="hover:text-[var(--accent)]"
            href={siteProfile.githubUrl}
            rel="noreferrer"
            target="_blank"
          >
            GitHub
          </a>
          <a
            class="hover:text-[var(--accent)]"
            href={siteProfile.linkedinUrl}
            rel="noreferrer"
            target="_blank"
          >
            LinkedIn
          </a>
          <a
            class="hover:text-[var(--accent)]"
            href={`mailto:${siteProfile.email}`}
          >
            {siteProfile.email}
          </a>
        </div>
      </aside>
    </section>

    <section class="grid gap-4 md:grid-cols-3">
      {
        profileHighlights.slice(0, 3).map((highlight) => (
          <article class="glass-panel rounded-[2rem] p-6">
            <p class="eyebrow text-xs text-[var(--muted)]">{highlight.label}</p>
            <p class="mt-3 text-3xl font-semibold">{highlight.value}</p>
            <p class="mt-3 text-sm leading-7 text-[var(--muted)]">
              {highlight.detail}
            </p>
          </article>
        ))
      }
    </section>

    <section class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_24rem]">
      <article class="glass-panel rounded-[2.5rem] p-8">
        <p class="eyebrow text-xs text-[var(--muted)]">Overall profile</p>
        <div class="mt-5 space-y-4 text-base leading-8 text-[var(--muted)]">
          {siteProfile.overview.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </article>

      <article class="glass-panel rounded-[2.5rem] p-8">
        <p class="eyebrow text-xs text-[var(--muted)]">Core skill surface</p>
        <div class="mt-5 flex flex-wrap gap-2">
          {
            topSkills.map((skill) => (
              <span class="rounded-full border border-[var(--line)] bg-white/80 px-3 py-2 text-sm font-semibold text-[var(--muted)]">
                {skill.label}
              </span>
            ))
          }
        </div>
      </article>
    </section>

    <section class="section-grid">
      <div
        class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between"
      >
        <div>
          <p class="eyebrow text-xs text-[var(--muted)]">Selected work</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight">
            Proof that carries the story
          </h2>
        </div>
        <a
          class="text-sm font-semibold text-[var(--accent)] hover:text-[var(--ink)]"
          href="/work"
        >
          View the manager deep dive
        </a>
      </div>

      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </section>

    <section class="grid gap-4 lg:grid-cols-3">
      {
        experiences.map((experience) => (
          <article class="glass-panel rounded-[2rem] p-6">
            <div class="flex items-center gap-4">
              <img
                alt={experience.company}
                class="h-12 w-12 rounded-2xl object-cover"
                src={experience.icon}
              />
              <div>
                <h3 class="text-lg font-semibold">{experience.company}</h3>
                <p class="text-sm text-[var(--muted)]">{experience.title}</p>
              </div>
            </div>
            <p class="mt-4 text-sm leading-7 text-[var(--muted)]">
              {experience.description}
            </p>
            <p class="mt-4 text-xs font-semibold uppercase tracking-[0.2em] text-[var(--muted)]">
              {experience.date}
            </p>
          </article>
        ))
      }
    </section>

    <section class="glass-panel rounded-[2.5rem] p-8 sm:p-10">
      <p class="eyebrow text-xs text-[var(--muted)]">Contact</p>
      <h2 class="mt-4 text-3xl font-semibold tracking-tight">Keep it direct</h2>
      <p class="mt-4 max-w-3xl text-base leading-8 text-[var(--muted)]">
        This site is intentionally optimized for clarity over gimmicks. If you
        want to talk about data platforms, backend engineering, streaming
        systems, AI-adjacent product engineering, or platform foundations, email
        me directly.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a
          class="rounded-full bg-[var(--accent)] px-5 py-3 text-sm font-semibold text-white hover:opacity-90"
          href={`mailto:${siteProfile.email}`}
        >
          Email {siteProfile.name}
        </a>
        <a
          class="rounded-full border border-[var(--line)] px-5 py-3 text-sm font-semibold hover:border-[var(--accent)] hover:bg-[var(--accent-soft)]"
          href="/resume"
        >
          Open recruiter resume
        </a>
      </div>
    </section>
  </main>
</BaseLayout>
