---
import HomePage from "@/src/components/home/HomePage";
import BaseLayout from "@/src/layouts/BaseLayout.astro";
import { getPortfolioContent } from "@/lib/portfolio-content";
import { getPublicProjectsFromContent } from "@/lib/portfolio";
import { PORTFOLIO_PAGE_CACHE_CONTROL } from "@/src/lib/wix";

Astro.response.headers.set("Cache-Control", PORTFOLIO_PAGE_CACHE_CONTROL);

const content = await getPortfolioContent();
const featuredProjects = getPublicProjectsFromContent(content)
  .filter((project) => project.featured)
  .slice(0, 3);
const homeTitle = "Vijay Jangir | Governed Data Platforms and Enterprise AI";
const homeDescription =
  "Architect and hands-on developer building governed conversational data platforms, metadata services, access-governance systems, workflow orchestration, CI/CD onboarding, and telecom-scale analytics.";
---

<BaseLayout
  description={homeDescription}
  siteProfile={content.siteProfile}
  title={homeTitle}
>
  <HomePage
    client:load
    experiences={content.experiences}
    featuredProjects={featuredProjects}
    profileHighlights={content.profileHighlights}
    siteProfile={content.siteProfile}
    skillDefinitions={content.skillDefinitions}
  />
</BaseLayout>
