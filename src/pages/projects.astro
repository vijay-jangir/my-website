---
import { getPortfolioContent } from "@/lib/portfolio-content";
import { parseFocusIds, searchProjectsInContent } from "@/lib/portfolio";
import type { FocusId } from "@/lib/portfolio-types";
import FocusPills from "@/src/components/FocusPills.astro";
import ProjectCard from "@/src/components/ProjectCard.astro";
import BaseLayout from "@/src/layouts/BaseLayout.astro";

const content = await getPortfolioContent();
const focusIds = parseFocusIds(Astro.url.searchParams.get("focus"));
const query = Astro.url.searchParams.get("q") ?? "";
const activeFocusIds: FocusId[] =
  focusIds.length > 0 ? [...focusIds] : ["general"];
const projects = searchProjectsInContent(content, {
  query,
  focusIds: activeFocusIds,
});
const skillLabels = Object.fromEntries(
  content.skillDefinitions.map((skill) => [skill.id, skill.label]),
) as Record<string, string>;
---

<BaseLayout
  description="Projects across data platforms, streaming systems, backend engineering, and platform foundations."
  siteProfile={content.siteProfile}
  title="Projects | Vijay Jangir"
>
  <main class="space-y-10 pb-4">
    <section
      class="rounded-[2.6rem] border border-white/70 bg-white/80 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:px-10 sm:py-10"
    >
      <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_21rem] lg:items-end">
        <div>
          <p
            class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Projects
          </p>
          <h1
            class="mt-4 font-['Sora'] text-5xl font-semibold leading-[0.96] tracking-[-0.05em] text-[#0e1528] sm:text-6xl"
          >
            Projects
          </h1>
          <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">
            Search by technology or problem area, and use the focus filters to
            move the most relevant projects to the top.
          </p>
        </div>

        <div class="rounded-[2rem] bg-white/60 px-5 py-5">
          <p
            class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Updated
          </p>
          <p class="mt-3 text-sm leading-7 text-slate-600">
            Last updated {content.siteProfile.lastUpdatedLabel}. Search by
            technology, architecture, or problem space.
          </p>
        </div>
      </div>

      <form class="mt-8 grid gap-4 lg:grid-cols-[minmax(0,1fr)_auto]">
        <input
          class="rounded-full border border-slate-200/80 bg-white/90 px-5 py-3 text-sm text-[#0e1528] outline-none transition focus:border-slate-300 focus:bg-white"
          name="q"
          placeholder="Search Flink, Kafka, backend, AI, observability..."
          type="search"
          value={query}
        />
        <button
          class="inline-flex items-center justify-center rounded-full bg-[#11192c] px-5 py-3 text-sm font-semibold text-white shadow-[0_14px_32px_rgba(17,25,44,0.16)] transition hover:-translate-y-0.5 hover:bg-[#0b1222]"
          type="submit"
        >
          Search
        </button>
      </form>

      <div class="mt-6">
        <FocusPills
          activeFocusIds={activeFocusIds}
          basePath="/projects"
          focusOptions={content.focusDefinitions}
          query={{ q: query || undefined }}
        />
      </div>

      {
        query || !activeFocusIds.includes("general") ? (
          <div class="mt-4">
            <a
              class="inline-flex items-center rounded-full border border-slate-200/80 bg-white/90 px-4 py-2 text-sm font-semibold text-slate-600 transition hover:border-slate-300 hover:bg-white hover:text-[#0e1528]"
              href="/projects"
            >
              Clear search and filters
            </a>
          </div>
        ) : null
      }
    </section>

    <section class="space-y-6">
      <div
        class="flex flex-col gap-3 lg:flex-row lg:items-center lg:justify-between"
      >
        <div>
          <p
            class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Results
          </p>
          <h2
            class="mt-3 font-['Sora'] text-4xl font-semibold leading-tight tracking-[-0.045em] text-[#0e1528]"
          >
            {projects.length}
            {projects.length === 1 ? "project" : "projects"}
          </h2>
        </div>
        {
          query ? (
            <p class="text-base leading-8 text-slate-600">
              Showing matches for{" "}
              <span class="font-semibold text-[#0e1528]">“{query}”</span>.
            </p>
          ) : (
            <p class="text-base leading-8 text-slate-600">
              Use the filters or search when you want a narrower list.
            </p>
          )
        }
      </div>

      {
        projects.length === 0 ? (
          <article class="rounded-[2rem] border border-white/70 bg-white/72 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.06)] backdrop-blur-xl">
            <p class="text-base leading-8 text-slate-600">
              No projects match that combination yet. Try a broader focus or a
              simpler search term.
            </p>
          </article>
        ) : (
          projects.map((project) => (
            <ProjectCard project={project} skillLabels={skillLabels} />
          ))
        )
      }
    </section>
  </main>
</BaseLayout>
