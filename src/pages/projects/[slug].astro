---
import { getPortfolioContent } from "@/lib/portfolio-content";
import { getSkillLabelFromContent } from "@/lib/portfolio";
import type { FocusId, ProjectDefinition } from "@/lib/portfolio-types";
import CaseList from "@/src/components/CaseList.astro";
import ArchitectureFlow from "@/src/components/projects/ArchitectureFlow.astro";
import ProjectPager from "@/src/components/projects/ProjectPager.astro";
import PublicProof from "@/src/components/projects/PublicProof.astro";
import RelatedProjects from "@/src/components/projects/RelatedProjects.astro";
import BaseLayout from "@/src/layouts/BaseLayout.astro";

export const prerender = false;

const content = await getPortfolioContent();
const slug = Astro.params.slug ?? "";
const project = content.projects.find(
  (item) => item.slug === slug && item.visibility === "public",
);

if (!project) {
  Astro.response.status = 404;
}

const caseStudy = project?.caseStudy;
const description =
  project?.summary ?? "Project case study from Vijay Jangir's portfolio.";
const publicProjects = content.projects.filter(
  (item) => item.visibility === "public",
);
const currentProjectIndex = project
  ? publicProjects.findIndex((item) => item.slug === project.slug)
  : -1;
const previousProject =
  currentProjectIndex > 0 ? publicProjects[currentProjectIndex - 1] : undefined;
const nextProject =
  currentProjectIndex >= 0 && currentProjectIndex < publicProjects.length - 1
    ? publicProjects[currentProjectIndex + 1]
    : undefined;
const skillLabelMap = Object.fromEntries(
  content.skillDefinitions.map((skill) => [skill.id, skill.label]),
) as Record<string, string>;
const focusLabelMap = Object.fromEntries(
  content.focusDefinitions.map((focus) => [focus.id, focus.label]),
) as Record<FocusId, string>;

function getSharedFocusIds(
  sourceProject: ProjectDefinition,
  candidateProject: ProjectDefinition,
) {
  return content.focusDefinitions
    .filter((focus) => {
      if (focus.id === "general") {
        return false;
      }

      return (
        (sourceProject.focusWeights[focus.id] ?? 0) > 0 &&
        (candidateProject.focusWeights[focus.id] ?? 0) > 0
      );
    })
    .map((focus) => focus.id);
}

function getRelatedProjects(sourceProject?: ProjectDefinition) {
  if (!sourceProject) {
    return [];
  }

  const sourceSkillIds = new Set(sourceProject.skillIds);

  return publicProjects
    .filter((candidate) => candidate.slug !== sourceProject.slug)
    .map((candidate) => {
      const sharedSkillIds = candidate.skillIds.filter((skillId) =>
        sourceSkillIds.has(skillId),
      );
      const sharedFocusIds = getSharedFocusIds(sourceProject, candidate);
      const score = sharedSkillIds.length * 3 + sharedFocusIds.length;
      const reasons = [
        ...sharedSkillIds
          .slice(0, 2)
          .map((skillId) => skillLabelMap[skillId] ?? skillId),
        ...sharedFocusIds.slice(0, 1).map((focusId) => focusLabelMap[focusId]),
      ].filter(Boolean);

      return {
        project: candidate,
        reasons,
        score,
      };
    })
    .filter((item) => item.score > 0 && item.reasons.length > 0)
    .sort((left, right) => right.score - left.score)
    .slice(0, 3)
    .map(({ project, reasons }) => ({ project, reasons }));
}

const relatedProjects = getRelatedProjects(project);
const publicProof = project?.publicProof;
const publicScopeText = caseStudy?.confidentiality;
const projectPageUrl = project
  ? new URL(`/projects/${project.slug}`, Astro.site ?? Astro.url).toString()
  : null;
const breadcrumbJsonLd = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      item: new URL("/", Astro.site ?? Astro.url).toString(),
      name: "Home",
      position: 1,
    },
    {
      "@type": "ListItem",
      item: new URL("/projects", Astro.site ?? Astro.url).toString(),
      name: "Projects",
      position: 2,
    },
    ...(project && projectPageUrl
      ? [
          {
            "@type": "ListItem",
            item: projectPageUrl,
            name: project.title,
            position: 3,
          },
        ]
      : []),
  ],
});

const projectJsonLd =
  project && projectPageUrl
    ? JSON.stringify({
        "@context": "https://schema.org",
        "@type": "CreativeWork",
        abstract: description,
        author: {
          "@type": "Person",
          name: content.siteProfile.name,
          url: new URL("/", Astro.site ?? Astro.url).toString(),
        },
        headline: project.title,
        mainEntityOfPage: projectPageUrl,
        ...(caseStudy?.timeframe ? { dateCreated: caseStudy.timeframe } : {}),
      })
    : null;
---

<BaseLayout
  description={description}
  siteProfile={content.siteProfile}
  title={project ? `${project.title} | Vijay Jangir` : "Project | Vijay Jangir"}
>
  <script is:inline set:html={breadcrumbJsonLd} type="application/ld+json" />
  {
    projectJsonLd ? (
      <script is:inline set:html={projectJsonLd} type="application/ld+json" />
    ) : null
  }
  <main class="space-y-10 pb-4">
    {
      project ? (
        <>
          <nav
            aria-label="Project breadcrumbs"
            class="flex flex-wrap items-center gap-3 text-sm font-semibold text-slate-600"
          >
            <a class="transition hover:text-[#1f3b73]" href="/projects">
              Project index
            </a>
            <span aria-hidden="true" class="text-slate-300">
              /
            </span>
            <span class="text-[#0e1528]">{project.title}</span>
          </nav>

          <section class="px-1 py-8">
            <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_22rem] lg:items-start">
              <div>
                <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]">
                  Project case study
                </p>
                <h1 class="mt-4 max-w-5xl break-words font-display text-5xl font-semibold leading-[0.94] tracking-[-0.055em] text-[#0e1528] sm:text-7xl">
                  {project.title}
                </h1>
                <p class="mt-5 max-w-3xl text-lg leading-8 text-slate-600">
                  {caseStudy?.headline ?? project.summary}
                </p>
                <p class="mt-5 max-w-3xl text-base leading-8 text-slate-600">
                  {project.impact}
                </p>
              </div>

              <aside class="rounded-[1.8rem] border border-slate-200/80 bg-white/78 px-6 py-6 shadow-[0_18px_48px_rgba(31,44,75,0.06)] backdrop-blur-xl">
                <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]">
                  Snapshot
                </p>
                <dl class="mt-4 space-y-4 text-sm leading-7 text-slate-600">
                  <div>
                    <dt class="font-semibold text-[#0e1528]">Role</dt>
                    <dd>{caseStudy?.role ?? "Project contributor"}</dd>
                  </div>
                  <div>
                    <dt class="font-semibold text-[#0e1528]">Timeframe</dt>
                    <dd>{caseStudy?.timeframe ?? "See resume timeline"}</dd>
                  </div>
                  <div>
                    <dt class="font-semibold text-[#0e1528]">Organization</dt>
                    <dd>{caseStudy?.organization ?? "Portfolio project"}</dd>
                  </div>
                  {caseStudy?.team ? (
                    <div>
                      <dt class="font-semibold text-[#0e1528]">Team</dt>
                      <dd>{caseStudy.team}</dd>
                    </div>
                  ) : null}
                </dl>
              </aside>
            </div>

            <div class="mt-8 flex flex-wrap gap-2">
              {project.skillIds.map((skillId) => (
                <span class="rounded-full border border-slate-200/80 bg-white/90 px-3 py-2 text-xs font-semibold text-slate-600">
                  {getSkillLabelFromContent(content, skillId)}
                </span>
              ))}
            </div>
          </section>

          {caseStudy ? (
            <>
              <section
                class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_22rem]"
                id="context"
              >
                <article class="rounded-[2.2rem] border border-white/70 bg-white/80 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:px-8">
                  <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]">
                    Context
                  </p>
                  <h2 class="mt-4 font-display text-4xl font-semibold leading-tight tracking-[-0.045em] text-[#0e1528]">
                    The problem
                  </h2>
                  <p class="mt-5 text-base leading-8 text-slate-600">
                    {caseStudy.context}
                  </p>
                  <p class="mt-5 text-base leading-8 text-slate-600">
                    {project.detail}
                  </p>
                </article>

                <aside class="rounded-[2.2rem] border border-white/70 bg-white/72 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.06)] backdrop-blur-xl">
                  <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]">
                    Details omitted
                  </p>
                  <p class="mt-4 text-sm leading-7 text-slate-600">
                    {publicScopeText}
                  </p>
                </aside>
              </section>

              <ArchitectureFlow items={caseStudy.architecture} />

              {caseStudy.metrics.length > 0 ? (
                <section class="grid gap-4 md:grid-cols-2" id="metrics">
                  {caseStudy.metrics.map((metric) => (
                    <article class="rounded-[2rem] border border-white/70 bg-white/80 px-6 py-7 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl">
                      <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]">
                        {metric.label}
                      </p>
                      <p class="mt-4 text-4xl font-semibold tracking-tight text-[#0e1528]">
                        {metric.value}
                      </p>
                      <p class="mt-3 text-sm leading-7 text-slate-600">
                        {metric.detail}
                      </p>
                    </article>
                  ))}
                </section>
              ) : null}

              <section class="grid gap-6 lg:grid-cols-3" id="case-study">
                <CaseList
                  eyebrow="Architecture"
                  items={caseStudy.architecture}
                  title="System shape"
                />
                <CaseList
                  eyebrow="Ownership"
                  items={caseStudy.responsibilities}
                  title="What I handled"
                />
                <CaseList
                  eyebrow="Lessons"
                  items={caseStudy.lessons}
                  title="What carried forward"
                />
              </section>

              {caseStudy.decisions.length > 0 ? (
                <section class="rounded-[2.2rem] border border-white/70 bg-white/80 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:px-8">
                  <p class="font-mono text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]">
                    Engineering decisions
                  </p>
                  <div class="mt-6 grid gap-5 md:grid-cols-2">
                    {caseStudy.decisions.map((decision) => (
                      <article class="rounded-[1.5rem] border border-slate-200/80 bg-white/80 px-5 py-5">
                        <h2 class="text-xl font-semibold tracking-tight text-[#0e1528]">
                          {decision.label}
                        </h2>
                        <p class="mt-3 text-sm leading-7 text-slate-600">
                          {decision.detail}
                        </p>
                      </article>
                    ))}
                  </div>
                </section>
              ) : null}
            </>
          ) : (
            <section class="rounded-[2rem] border border-white/70 bg-white/72 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.06)] backdrop-blur-xl">
              <p class="text-base leading-8 text-slate-600">
                This project is currently represented as a portfolio summary. A
                deeper case study can be added from the content model.
              </p>
            </section>
          )}

          {publicProof ? <PublicProof proof={publicProof} /> : null}

          <section
            class="rounded-[2rem] border border-white/70 bg-white/72 px-6 py-6 shadow-[0_18px_54px_rgba(31,44,75,0.06)] backdrop-blur-xl sm:px-8"
            id="continue"
          >
            <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
              <div>
                <p class="text-sm font-semibold text-[#1f3b73]">
                  Related case studies
                </p>
                <p class="mt-2 text-sm leading-7 text-slate-600">
                  Continue through related work or return to the full project
                  index.
                </p>
              </div>
              <div class="flex flex-wrap gap-3">
                <a
                  class="inline-flex items-center rounded-full bg-[#11192c] px-5 py-3 text-sm font-semibold text-white shadow-[0_14px_32px_rgba(17,25,44,0.16)] transition hover:-translate-y-0.5 hover:bg-[#0b1222]"
                  href="/projects"
                >
                  All projects
                </a>
                {project.proofLinks.map((link) => (
                  <a
                    class="inline-flex items-center rounded-full border border-slate-200/80 bg-white/90 px-5 py-3 text-sm font-semibold text-[#0e1528] transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-white"
                    href={link.href}
                    rel="noreferrer"
                    target="_blank"
                  >
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </section>

          <ProjectPager
            nextProject={nextProject}
            previousProject={previousProject}
          />

          <RelatedProjects projects={relatedProjects} />
        </>
      ) : (
        <section class="rounded-[2rem] border border-white/70 bg-white/72 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.06)] backdrop-blur-xl">
          <h1 class="font-display text-4xl font-semibold tracking-[-0.045em] text-[#0e1528]">
            Project not found
          </h1>
          <p class="mt-4 text-base leading-8 text-slate-600">
            No public project matched this URL.
          </p>
          <a
            class="mt-6 inline-flex items-center rounded-full bg-[#11192c] px-5 py-3 text-sm font-semibold text-white"
            href="/projects"
          >
            Back to projects
          </a>
        </section>
      )
    }
  </main>
</BaseLayout>
