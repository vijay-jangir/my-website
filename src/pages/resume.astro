---
import { focusDefinitions, siteProfile } from "@/content/portfolio";
import {
  buildResumeVariant,
  getSkillLabel,
  parseFocusIds,
} from "@/lib/portfolio";
import { getResumeVariantByToken } from "@/lib/resume-store";
import type { FocusId } from "@/lib/portfolio-types";
import FocusPills from "@/src/components/FocusPills.astro";
import BaseLayout from "@/src/layouts/BaseLayout.astro";

const focusIds = parseFocusIds(Astro.url.searchParams.get("focus"));
const variantToken = Astro.url.searchParams.get("variant") ?? undefined;
const storedVariant = variantToken
  ? await getResumeVariantByToken(variantToken)
  : null;
const variant =
  storedVariant?.variant ??
  buildResumeVariant({
    focusIds,
  });
const selectedFocusIds: readonly FocusId[] =
  variant.focusIds.length > 0 ? variant.focusIds : ["general"];
const pdfParams = storedVariant?.token
  ? new URLSearchParams({ variant: storedVariant.token })
  : new URLSearchParams({ focus: selectedFocusIds.join(",") });
---

<BaseLayout
  description="Focused resume views for data, platform, streaming, AI, and backend roles."
  title="Resume | Vijay Jangir"
>
  <main class="mt-10 space-y-8 sm:mt-14">
    <section class="grid gap-6 lg:grid-cols-[minmax(0,1.45fr)_20rem]">
      <div class="glass-panel rounded-[2.5rem] p-8 sm:p-10">
        <p class="eyebrow text-xs text-[var(--muted)]">
          Recruiter-ready resume
        </p>
        <h1 class="mt-4 text-4xl font-semibold tracking-tight sm:text-5xl">
          {variant.headline}
        </h1>
        <p class="mt-5 max-w-3xl text-base leading-8 text-[var(--muted)]">
          {variant.summary}
        </p>
        <p class="mt-4 max-w-3xl text-sm leading-7 text-[var(--muted)]">
          {siteProfile.recruiterPitch}
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            class="rounded-full bg-[var(--ink)] px-5 py-3 text-sm font-semibold text-white hover:opacity-90"
            href={`/api/resume/pdf?${pdfParams.toString()}`}
          >
            Download ATS PDF
          </a>
          <a
            class="rounded-full border border-[var(--line)] px-5 py-3 text-sm font-semibold hover:border-[var(--accent)] hover:bg-[var(--accent-soft)]"
            href="/work"
          >
            Browse selected work
          </a>
        </div>
      </div>

      <aside class="glass-panel rounded-[2.5rem] p-6">
        {
          variant.highlights.map((highlight) => (
            <div class="not-last:mb-6">
              <p class="eyebrow text-xs text-[var(--muted)]">
                {highlight.label}
              </p>
              <p class="mt-2 text-2xl font-semibold">{highlight.value}</p>
              <p class="mt-2 text-sm leading-7 text-[var(--muted)]">
                {highlight.detail}
              </p>
            </div>
          ))
        }
      </aside>
    </section>

    <section class="glass-panel rounded-[2.5rem] p-8">
      <div
        class="flex flex-col gap-3 lg:flex-row lg:items-end lg:justify-between"
      >
        <div>
          <p class="eyebrow text-xs text-[var(--muted)]">Focus the resume</p>
          <h2 class="mt-3 text-3xl font-semibold tracking-tight">
            Choose what to emphasize
          </h2>
        </div>
        <p class="max-w-2xl text-sm leading-7 text-[var(--muted)]">
          Focuses update the summary, project ordering, and skill weighting
          without inventing any new claims.
        </p>
      </div>
      <div class="mt-6">
        <FocusPills
          activeFocusIds={selectedFocusIds}
          basePath="/resume"
          focusOptions={focusDefinitions}
        />
      </div>
    </section>

    <section class="grid gap-6 lg:grid-cols-[minmax(0,1.1fr)_minmax(0,0.9fr)]">
      <div class="section-grid">
        <article class="glass-panel rounded-[2rem] p-8">
          <h2 class="text-2xl font-semibold tracking-tight">Selected work</h2>
          <div class="mt-6 space-y-5">
            {
              variant.projects.map((project) => (
                <article class="rounded-[1.5rem] border border-[var(--line)] bg-white/70 p-5">
                  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                    <div>
                      <h3 class="text-xl font-semibold">{project.title}</h3>
                      <p class="mt-3 text-sm leading-7 text-[var(--muted)]">
                        {project.summary}
                      </p>
                    </div>
                    <div class="flex flex-wrap gap-2">
                      {project.skillIds.slice(0, 4).map((skillId) => (
                        <span class="rounded-full bg-[var(--accent-soft)] px-3 py-1 text-xs font-semibold text-[var(--accent)]">
                          {getSkillLabel(skillId)}
                        </span>
                      ))}
                    </div>
                  </div>
                  <p class="mt-4 text-sm leading-7 text-[var(--muted)]">
                    {project.impact}
                  </p>
                </article>
              ))
            }
          </div>
        </article>

        <article class="glass-panel rounded-[2rem] p-8">
          <h2 class="text-2xl font-semibold tracking-tight">Experience</h2>
          <div class="mt-6 space-y-6">
            {
              variant.experiences.map((experience) => (
                <article>
                  <div class="flex flex-col gap-2 lg:flex-row lg:items-center lg:justify-between">
                    <h3 class="text-xl font-semibold">
                      {experience.title} · {experience.company}
                    </h3>
                    <p class="text-sm text-[var(--muted)]">{experience.date}</p>
                  </div>
                  <p class="mt-3 text-sm leading-7 text-[var(--muted)]">
                    {experience.description}
                  </p>
                  <ul class="mt-4 space-y-2 text-sm leading-7 text-[var(--muted)]">
                    {experience.bullets.map((bullet) => (
                      <li>• {bullet.text}</li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </article>
      </div>

      <div class="section-grid">
        <article class="glass-panel rounded-[2rem] p-8">
          <h2 class="text-2xl font-semibold tracking-tight">Primary skills</h2>
          <div class="mt-6 flex flex-wrap gap-3">
            {
              variant.primarySkills.map((skill) => (
                <span class="rounded-full bg-[var(--ink)] px-4 py-2 text-sm font-semibold text-white">
                  {skill.label}
                </span>
              ))
            }
          </div>
        </article>

        <article class="glass-panel rounded-[2rem] p-8">
          <h2 class="text-2xl font-semibold tracking-tight">
            Secondary skills
          </h2>
          <div class="mt-6 flex flex-wrap gap-3">
            {
              variant.secondarySkills.map((skill) => (
                <span class="rounded-full border border-[var(--line)] px-4 py-2 text-sm font-semibold text-[var(--muted)]">
                  {skill.label}
                </span>
              ))
            }
          </div>
        </article>

        <article class="glass-panel rounded-[2rem] p-8">
          <h2 class="text-2xl font-semibold tracking-tight">
            Supporting context
          </h2>
          <div class="mt-6 flex flex-wrap gap-3">
            {
              variant.supportingSkills.map((skill) => (
                <span class="rounded-full border border-dashed border-[var(--line)] px-4 py-2 text-sm font-semibold text-[var(--muted)]">
                  {skill.label}
                </span>
              ))
            }
          </div>
        </article>

        {
          variant.analysis ? (
            <article class="glass-panel rounded-[2rem] p-8">
              <h2 class="text-2xl font-semibold tracking-tight">JD analysis</h2>
              <ul class="mt-4 space-y-2 text-sm leading-7 text-[var(--muted)]">
                {variant.analysis.extractedHighlights.map((highlight) => (
                  <li>{highlight}</li>
                ))}
              </ul>
            </article>
          ) : null
        }
      </div>
    </section>
  </main>
</BaseLayout>
