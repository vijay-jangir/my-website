---
import { focusDefinitions, siteProfile } from "@/content/portfolio";
import {
  buildResumeVariant,
  getSkillLabel,
  parseFocusIds,
} from "@/lib/portfolio";
import { getResumeVariantByToken } from "@/lib/resume-store";
import type { FocusId } from "@/lib/portfolio-types";
import FocusPills from "@/src/components/FocusPills.astro";
import BaseLayout from "@/src/layouts/BaseLayout.astro";

const focusIds = parseFocusIds(Astro.url.searchParams.get("focus"));
const variantToken = Astro.url.searchParams.get("variant") ?? undefined;
const storedVariant = variantToken
  ? await getResumeVariantByToken(variantToken)
  : null;
const variant =
  storedVariant?.variant ??
  buildResumeVariant({
    focusIds,
  });
const selectedFocusIds: readonly FocusId[] =
  variant.focusIds.length > 0 ? variant.focusIds : ["general"];
const pdfParams = storedVariant?.token
  ? new URLSearchParams({ variant: storedVariant.token })
  : new URLSearchParams({ focus: selectedFocusIds.join(",") });
---

<BaseLayout
  description="Focused resume views for data, platform, streaming, AI, and backend roles."
  title="Resume | Vijay Jangir"
>
  <main class="space-y-10 pb-4">
    <section class="grid gap-6 lg:grid-cols-[minmax(0,1.2fr)_21rem]">
      <article
        class="rounded-[2.6rem] border border-white/10 bg-[radial-gradient(circle_at_12%_12%,rgba(176,177,255,0.18),transparent_24%),radial-gradient(circle_at_100%_0%,rgba(255,214,223,0.18),transparent_28%),linear-gradient(145deg,#111a30_0%,#152240_54%,#1f3057_100%)] px-6 py-8 text-white shadow-[0_28px_80px_rgba(17,26,48,0.2)] sm:px-10 sm:py-10"
      >
        <p
          class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-white/70"
        >
          Resume
        </p>
        <h1
          class="mt-4 font-['Sora'] text-5xl font-semibold leading-[0.96] tracking-[-0.05em] sm:text-6xl"
        >
          {variant.headline}
        </h1>
        <p class="mt-5 max-w-3xl text-lg leading-8 text-white/80">
          {variant.summary}
        </p>
        <p class="mt-5 max-w-3xl text-sm leading-7 text-white/65">
          Pick a focus to shift the emphasis without changing the underlying
          facts.
        </p>

        <div class="mt-8 flex flex-wrap gap-3">
          <a
            class="inline-flex items-center rounded-full bg-white px-5 py-3 text-sm font-semibold text-[#0e1528] shadow-[0_12px_30px_rgba(255,255,255,0.16)] transition hover:-translate-y-0.5"
            href={`/api/resume/pdf?${pdfParams.toString()}`}
          >
            Download PDF
          </a>
          <a
            class="inline-flex items-center rounded-full border border-white/20 bg-white/10 px-5 py-3 text-sm font-semibold text-white transition hover:bg-white/20"
            href="/work"
          >
            See related work
          </a>
        </div>
      </article>

      <aside
        class="rounded-[2.4rem] border border-white/70 bg-white/80 px-6 py-7 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl"
      >
        <p
          class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
        >
          Quick view
        </p>
        <div class="mt-5 space-y-6">
          {
            variant.highlights.map((highlight) => (
              <div class="border-t border-slate-200/80 pt-6 first:border-t-0 first:pt-0">
                <p class="text-sm font-semibold uppercase tracking-[0.16em] text-slate-500">
                  {highlight.label}
                </p>
                <p class="mt-3 text-3xl font-semibold tracking-tight text-[#0e1528]">
                  {highlight.value}
                </p>
                <p class="mt-2 text-sm leading-7 text-slate-600">
                  {highlight.detail}
                </p>
              </div>
            ))
          }
        </div>
      </aside>
    </section>

    <section
      class="rounded-[2.4rem] border border-white/70 bg-white/72 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.06)] backdrop-blur-xl sm:px-8"
    >
      <div
        class="flex flex-col gap-4 lg:flex-row lg:items-end lg:justify-between"
      >
        <div>
          <p
            class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Choose a version
          </p>
          <h2
            class="mt-4 font-['Sora'] text-4xl font-semibold leading-tight tracking-[-0.05em] text-[#0e1528] sm:text-5xl"
          >
            Shift the emphasis
          </h2>
        </div>
        <p class="max-w-2xl text-base leading-8 text-slate-600">
          Projects, skills, and experience bullets reorder around the focus you
          choose.
        </p>
      </div>
      <div class="mt-6">
        <FocusPills
          activeFocusIds={selectedFocusIds}
          basePath="/resume"
          focusOptions={focusDefinitions}
        />
      </div>
    </section>

    <section
      class="grid gap-6 lg:grid-cols-[minmax(0,1.08fr)_minmax(17rem,0.92fr)]"
    >
      <div class="space-y-6">
        <article
          class="rounded-[2.3rem] border border-white/70 bg-white/80 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:px-8"
        >
          <p
            class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Selected work
          </p>
          <h2
            class="mt-4 font-['Sora'] text-4xl font-semibold leading-tight tracking-[-0.05em] text-[#0e1528]"
          >
            Best matching projects
          </h2>
          <div class="mt-6 space-y-6">
            {
              variant.projects.map((project) => (
                <article class="border-t border-slate-200/80 pt-6 first:border-t-0 first:pt-0">
                  <div class="flex flex-col gap-4 lg:flex-row lg:items-start lg:justify-between">
                    <div>
                      <h3 class="text-2xl font-semibold tracking-tight text-[#0e1528]">
                        {project.title}
                      </h3>
                      <p class="mt-3 text-base leading-8 text-slate-600">
                        {project.summary}
                      </p>
                    </div>
                    <div class="flex flex-wrap gap-2 lg:max-w-[14rem] lg:justify-end">
                      {project.skillIds.slice(0, 4).map((skillId) => (
                        <span class="rounded-full border border-slate-200/80 bg-white/90 px-3 py-2 text-xs font-semibold text-slate-600">
                          {getSkillLabel(skillId)}
                        </span>
                      ))}
                    </div>
                  </div>
                  <p class="mt-4 text-base leading-8 text-slate-600">
                    {project.impact}
                  </p>
                </article>
              ))
            }
          </div>
        </article>

        <article
          class="rounded-[2.3rem] border border-white/70 bg-white/80 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl sm:px-8"
        >
          <p
            class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Experience
          </p>
          <h2
            class="mt-4 font-['Sora'] text-4xl font-semibold leading-tight tracking-[-0.05em] text-[#0e1528]"
          >
            What that looks like in practice
          </h2>
          <div class="mt-6 space-y-6">
            {
              variant.experiences.map((experience) => (
                <article class="border-t border-slate-200/80 pt-6 first:border-t-0 first:pt-0">
                  <div class="flex flex-col gap-2 lg:flex-row lg:items-start lg:justify-between">
                    <div>
                      <h3 class="text-2xl font-semibold tracking-tight text-[#0e1528]">
                        {experience.title} · {experience.company}
                      </h3>
                      <p class="mt-2 text-base leading-8 text-slate-600">
                        {experience.description}
                      </p>
                    </div>
                    <p class="text-sm font-medium text-slate-500">
                      {experience.date}
                    </p>
                  </div>
                  <ul class="mt-5 space-y-3 text-base leading-8 text-slate-600">
                    {experience.bullets.map((bullet) => (
                      <li class="flex gap-3">
                        <span class="mt-[0.72rem] h-2 w-2 rounded-full bg-[#1f3b73]" />
                        <span>{bullet.text}</span>
                      </li>
                    ))}
                  </ul>
                </article>
              ))
            }
          </div>
        </article>
      </div>

      <div class="space-y-6">
        <article
          class="rounded-[2.3rem] border border-white/70 bg-white/72 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.06)] backdrop-blur-xl"
        >
          <p
            class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Primary skills
          </p>
          <h2
            class="mt-4 font-['Sora'] text-3xl font-semibold leading-tight tracking-[-0.045em] text-[#0e1528]"
          >
            Most relevant right now
          </h2>
          <div class="mt-6 flex flex-wrap gap-3">
            {
              variant.primarySkills.map((skill) => (
                <span class="rounded-full bg-[#11192c] px-4 py-2 text-sm font-semibold text-white">
                  {skill.label}
                </span>
              ))
            }
          </div>
        </article>

        <article
          class="rounded-[2.3rem] border border-white/70 bg-white/80 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl"
        >
          <p
            class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Secondary skills
          </p>
          <h2
            class="mt-4 font-['Sora'] text-3xl font-semibold leading-tight tracking-[-0.045em] text-[#0e1528]"
          >
            Relevant supporting depth
          </h2>
          <div class="mt-6 flex flex-wrap gap-3">
            {
              variant.secondarySkills.map((skill) => (
                <span class="rounded-full border border-slate-200/80 bg-white/90 px-4 py-2 text-sm font-semibold text-slate-600">
                  {skill.label}
                </span>
              ))
            }
          </div>
        </article>

        <article
          class="rounded-[2.3rem] border border-white/70 bg-white/80 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.07)] backdrop-blur-xl"
        >
          <p
            class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Also part of the stack
          </p>
          <h2
            class="mt-4 font-['Sora'] text-3xl font-semibold leading-tight tracking-[-0.045em] text-[#0e1528]"
          >
            Useful context, not the headline
          </h2>
          <div class="mt-6 flex flex-wrap gap-3">
            {
              variant.supportingSkills.map((skill) => (
                <span class="rounded-full border border-dashed border-slate-200/80 px-4 py-2 text-sm font-semibold text-slate-600">
                  {skill.label}
                </span>
              ))
            }
          </div>
        </article>

        <article
          class="rounded-[2.3rem] border border-white/70 bg-white/72 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.06)] backdrop-blur-xl"
        >
          <p
            class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]"
          >
            Direct links
          </p>
          <h2
            class="mt-4 font-['Sora'] text-3xl font-semibold leading-tight tracking-[-0.045em] text-[#0e1528]"
          >
            Need the short path?
          </h2>
          <div class="mt-6 flex flex-wrap gap-3">
            <a
              class="inline-flex items-center rounded-full border border-slate-200/80 bg-white/90 px-5 py-3 text-sm font-semibold text-[#0e1528] shadow-[0_10px_24px_rgba(31,44,75,0.06)] transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-white"
              href="/work"
            >
              Selected work
            </a>
            <a
              class="inline-flex items-center rounded-full border border-slate-200/80 bg-white/90 px-5 py-3 text-sm font-semibold text-[#0e1528] shadow-[0_10px_24px_rgba(31,44,75,0.06)] transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-white"
              href={`mailto:${siteProfile.email}`}
            >
              Email
            </a>
            <a
              class="inline-flex items-center rounded-full border border-slate-200/80 bg-white/90 px-5 py-3 text-sm font-semibold text-[#0e1528] shadow-[0_10px_24px_rgba(31,44,75,0.06)] transition hover:-translate-y-0.5 hover:border-slate-300 hover:bg-white"
              href={siteProfile.linkedinUrl}
              rel="noreferrer"
              target="_blank"
            >
              LinkedIn
            </a>
          </div>
        </article>

        {
          variant.analysis ? (
            <article class="rounded-[2.3rem] border border-white/70 bg-white/72 px-6 py-8 shadow-[0_18px_54px_rgba(31,44,75,0.06)] backdrop-blur-xl">
              <p class="font-['IBM_Plex_Mono'] text-[0.72rem] uppercase tracking-[0.24em] text-[#1f3b73]">
                JD notes
              </p>
              <h2 class="mt-4 font-['Sora'] text-3xl font-semibold leading-tight tracking-[-0.045em] text-[#0e1528]">
                Captured from the role
              </h2>
              <ul class="mt-6 space-y-3 text-base leading-8 text-slate-600">
                {variant.analysis.extractedHighlights.map((highlight) => (
                  <li class="flex gap-3">
                    <span class="mt-[0.72rem] h-2 w-2 rounded-full bg-[#1f3b73]" />
                    <span>{highlight}</span>
                  </li>
                ))}
              </ul>
            </article>
          ) : null
        }
      </div>
    </section>
  </main>
</BaseLayout>
