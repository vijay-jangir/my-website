{
  "extends": "astro/tsconfigs/strict",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "jsxImportSource": "react",
    "paths": {
      "@/*": ["./*"]
    },
    "types": ["node"]
  },
  "include": [
    ".astro/types.d.ts",
    "src/**/*",
    "content/**/*",
    "db/**/*",
    "lib/db.ts",
    "lib/drizzle.ts",
    "lib/env.ts",
    "lib/llm/**/*",
    "lib/jd.ts",
    "lib/portfolio-types.ts",
    "lib/portfolio.ts",
    "lib/resume-store.ts",
    "lib/turnstile.ts",
    "db/drizzle/**/*",
    "drizzle.config.ts",
    "vitest.config.ts"
  ],
  "exclude": ["node_modules", "dist", ".next", "legacy-next"]
}
